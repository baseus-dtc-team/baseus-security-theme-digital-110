  <style>
.animationbox2 {
  height: 1600px;
  position: relative;
  background: linear-gradient(to right, #010100, #2b2e32 50%, #010100);
  z-index: 3;
}
.animationfixed2 {
  position: absolute;
  top: 0;
  bottom: auto;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  /* height: 100%; */
  width: 100%;
  z-index: 3;
  overflow: hidden;
}
.canvasbg2 {
  display:block;
  width: 100%;
  height: auto;
  /* max-height: 100%; */
}
     .canvasbg22{
       display: none;
       width: 100%;
       /* max-height: 100%; */
     }
.pro-title2 {
  position: fixed;
  z-index: 10;
  top: 55vh;
  left: 10vw;
  color: white;
  opacity: 0;
  width: 30vw
}
.animation_title2 {
  font-size: 2.3vw;
  font-weight:bold;
}
.animation_content2 {
  font-size: 1.3vw;
  color: #ffffff;
}
   .animation_bottomgap2{
    height:5px;
    background-color: #000000;
    position: relative;
    z-index: 3;
  }
  .pro-title2-1{
  position: fixed;
  z-index: 10;
  top: 20vh;
  color: #ffffff;
  opacity: 0;
  width: 100vw;
  text-align: center;
  display:none;
  }
  .pro-box2 {
    position: fixed;
    opacity: 0;
    width: 100%;
    z-index: 10;
  } 
@media screen and (min-width: 576px) {
    .slideshow__bottom {
        margin-top: 250px;
    }
}  
    @media screen and (max-width: 750px) {
      .animationfixed2{
        align-items: center;
      }      
     .canvasbg2 {
       display: none;
      }
     .canvasbg22{
       display: block;
     }
   .pro-box2 {
    width: 100%;
  }
      .animation_content2{
        font-size: 16px;
        line-height: 20px;
      }
      .animation_title2{
  font-size: 24px;
  line-height: 28px;
  font-weight:blod;
      }
      .pro-title2-1{
     bottom: unset;
      top: 100px;
      }
     .pro-title2 {
        top: 35vh;
        width: 100vw;
        padding: 0 20px;
        text-align: center;
        left: 0; 
      }
  }
