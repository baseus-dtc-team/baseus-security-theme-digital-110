     <!-- <div class="animation_bottomgap2"></div> -->
   <div class="animationcontain2">
   <div class="animationbox2" id="canvasbox2">
    <div class="pro-title2-1 pro-box2" id="pro-box21">
      <div class="animation_title2">{{ section.settings.text1 }}</div>
      <div class="animation_content2">{{ section.settings.text2 }}</div>
    </div>
    <div class="animationfixed2" id="canvasfixed2">
      <canvas
        class="canvasbg2"
        id="background2"
        width="1920"
        height="1080"></canvas>
       <canvas
          class="canvasbg22"
          width="750"
          height="1334"
          id="background22"></canvas>
    </div>
  </div>  
  </div>
  <!-- <div class="animation_bottomgap2"></div> -->   

<script>
window.addEventListener('load', function() {
  // 所有资源(包括图片)加载完成后再计算   
   let screenWidth2 = window.screen.width
      var images2 = new Array();
      var totalImages2 = 75;
      var abc2 = 1;
      var funTip2 = 0;
  if(screenWidth2>750){
        for (var i = 1; i < totalImages2; i++) {
        var img2 = new Image();
        var slug2 = "000" + i;
        img2.src =
          "https://cdn.shopify.com/s/files/1/0555/8432/5709/files/x1-sun-turn-0" + slug2.slice(-3) + ".jpg";
        images2.push(img2);
      }
  }else{
       for (var i = 1; i < totalImages2; i++) {
        var img2 = new Image();
        var slug2 = "000" + i;
        img2.src =
          "https://cdn.shopify.com/s/files/1/0555/8432/5709/files/x1mo-sun-turn-0" + slug2.slice(-3) + ".jpg";
        images2.push(img2);
      }
  }
      let head1 = document.querySelector('.announcement-bar').offsetHeight;
      let header2 = document.querySelector('.shopify-section-header').offsetHeight;
      let topslide = document.querySelector('.x1-slideshow-container').offsetHeight;
      {% comment %} let topmulti = document.querySelector('.x1-grid-section').offsetHeight;  {% endcomment %}
      // let head1 = document.querySelector('.announcement-bar').offsetHeight;
      // let header2 = document.querySelector('.header').offsetHeight;
      // let topslide = document.querySelector('.shopify-section--slideshow').offsetHeight;
      // let topmulti = document.querySelector('.shopify-section--multi-column').offsetHeight;
      let topemail = document.querySelector('.vr2-anchor-content').offsetHeight;            
      let distop2 = document.querySelector('.animationcontain2').getBoundingClientRect().top;
      {% comment %} let topcard =  document.querySelector('.x1-card-section').offsetHeight; {% endcomment %}
      var showtime2 = document.getElementById("canvasbox2");
      var showfixed2 = document.getElementById("canvasfixed2");
      // var c2 = document.getElementById("background2");
      if(screenWidth2>750){
        var c2 = document.getElementById("background2");
        //加载第一张图片
      setTimeout(() => {
          ctx2.fillRect(0, 0, c2.width, c2.height);
          ctx2.drawImage(images2[1], 0, 0, c2.width, c2.height);
      }, 200);        
      }else{
        var c2 = document.getElementById("background22");
        //加载第一张图片
      setTimeout(() => {
          ctx2.fillRect(0, 0, c2.width, c2.height);
          ctx2.drawImage(images2[1], 0, 0, c2.width, c2.height);
      }, 200);        
      }
      var ctx2 = c2.getContext("2d");
      var protitle21 = document.getElementById("pro-box21");
      function swiper2(e) {
        funTip2 = 1;
        var scrollTop2 =
          (window.pageYOffset || document.documentElement.scrollTop) - distop2
        if (parseInt(scrollTop2 / 8) < 1) {
          abc2 = 1;
        } else {
          abc2 = parseInt(scrollTop2 / 8);
        }
        if (abc2 >= 5 && abc2 <= 70) {
        protitle21.style.display = "block";   
        if (abc2 >= 60 && abc2 <= 70) {
          protitle21.style.opacity = 1 - (abc2 - 60) / 10;
          protitle21.style.transform = 'translateY(-'+ (abc2 - 60) + 'vh)';          
        } else{
          protitle21.style.opacity = 1;
          protitle21.style.transform = 'translateY(-0vh)';     
        } 
        } else {
          protitle21.style.opacity = 0;
          protitle21.style.display = "none"; 
        }     
         if(screenWidth2>750){
           var screenHeigt2 = 1080 - 146
        if (abc2 <= 70) {
          ctx2.fillRect(0, 0, c2.width, c2.height);
          ctx2.drawImage(images2[abc2], 0, 0, c2.width, c2.height);
        }
        if (abc2 > 70) {
          ctx2.fillRect(0, 0, c2.width, c2.height);
          ctx2.drawImage(images2[71], 0, 0, c2.width, c2.height);
        }              
         }else{
           var screenHeigt2 = 844
        if (abc2 <= 70) {
          ctx2.fillRect(0, 0, c2.width, c2.height);
          ctx2.drawImage(images2[abc2], 0, 0, c2.width, c2.height);
        }
        if (abc2 > 70) {
          ctx2.fillRect(0, 0, c2.width, c2.height);
          ctx2.drawImage(images2[71], 0, 0, c2.width, c2.height);
        }              
         }
        if (
          document.documentElement.scrollTop >=
          distop2 - screenHeigt2 + 1600
        ) {
          showfixed2.style.position = "absolute";
          showfixed2.style.bottom = "0";
          showfixed2.style.top = "auto";
        } else {
          showfixed2.style.position = "fixed";
          if(screenWidth2>750){
           showfixed2.style.top = topemail + "px"; 
          }else {
           showfixed2.style.top = 0 + "px"; 
          }
          
          showfixed2.style.bottom = "auto";
        }
      }
   // var advanceShow2 = `-${c1.height - head1 - header2}px`
      var observer2 = new IntersectionObserver(
        (entries2) => {
          entries2.forEach((i2) => {
            // 通过滚动判断是否是当前的监听对象
            if (i2.isIntersecting) {
              showfixed2.style.position = "fixed";
              showfixed2.style.alignItems = "center";
              protitle21.style.display = "block";  
              console.log("出现2");
              window.onscroll = swiper2;
              return;
            } else {
              showfixed2.style.position = "unset";
              showfixed2.style.alignItems = "flex-start";
              protitle21.style.display = "none";
              console.log("消失2");
              if (funTip2 > 0) {
                window.onscroll = undefined;
              }
              return;
            }
          });
        },
        {
         rootMargin: screenWidth2 > 1000 ? "0px 0px -1080px 0px" : "0px 0px -712px 0px", // 提前150px进入可视区域时就加载图片，提高用户体验
           // rootMargin: "0px 0px " + advanceShow2 + " 0px"
        }
      );
      // observer2.observe(showtime2);
        function addEvent2(obj,type,fn){
    if(obj.attachEvent){ //ie
        obj.attachEvent('on'+type,function(){
            fn.call(obj);
        })
    }else{
        obj.addEventListener(type,fn,false);
    }
}
addEvent2(window,'scroll',function(){
          var scrollTopShow = (window.pageYOffset || document.documentElement.scrollTop)
      if(scrollTopShow >  distop2 - head1 - header2 && scrollTopShow < distop2 + 1600){
         observer2.observe(showtime2);
      }else{
        observer2.unobserve(showtime2);
        showfixed2.style.position = "unset";
      }
});
});
</script>
