{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}
    <style>
      .help-allcontain {
        display: flex;
        gap: 15px;
        text-align: left;
        margin-top: 5.6rem;
      }
      .help-contain1 {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 15px;
      }
      .help-img1 {
        width: 100%;
        border-radius: 10px;
      }
      .help-box1 {
        display: flex;
        gap: 20px;
      }
      .help-img2 {
        width: 100%;
        border-radius: 10px;
      }
      .help-contain2 {
        width: 100%;
        display: flex;
        flex-direction: column-reverse;
        gap: 15px;
      }
      .help-imgbox1 {
        position: relative;
        overflow: hidden;
      }
      .help-textbox1 {
        position: absolute;
        top: 25px;
        left: 25px;
      }
      .help-texttitle {
        font-size: 28px;
        font-weight: bold;
        margin-bottom: 10px;
      }
      .help-textdes {
        font-size: 20px;
      }
      .help-imgbox1 img {
        transition: all 0.6s;        
      }
      .help-imgbox1 img:hover {
        transform: scale(1.1);        
      }
      @media screen and (max-width: 750px) {
        .help-allcontain {
          flex-direction: column;
          gap: 5px;
          margin-top: 2.4rem;
        }
        .help-contain1 {
          gap: 5px;
        }
        .help-contain2 {
          gap: 5px;
        }
        .help-textbox1 {
          top: 10px;
          left: 10px;
        }
        .help-box1 {
          gap: 10px;
        }
        .help-texttitle {
          font-size: 16px;
          line-height: 18px;
          margin-bottom: 4px;
        }
        .help-textdes {
          font-size: 14px;
          line-height: 16px;
        }
      }
    </style>
<div class="rich-text {% if section.settings.full_width %}rich-text--full-width {% else %}container{% endif %} rich-text--align-{{ section.settings.alignment }}">
  <div class="rich-text__blocks {% if section.settings.full_width %}container{% endif %} color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'subheading' -%}
          <div
            class="rich-text__subheading subtitle"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.subheading | escape }}
          </div>
        {%- when 'heading' -%}
          <h2
            class="rich-text__heading title--section {% if block.settings.heading_size == 'medium' %}h2{% else %}h1{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.heading }}
          </h2>
        {%- when 'text' -%}
          <div class="rich-text__text" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </div>
        {%- when 'button' -%}
          <a
            {% if block.settings.button_link == blank %}
              aria-disabled="true"
            {% else %}
              href="{{ block.settings.button_link }}"
            {% endif %}
            class="button button--{{ block.settings.button_style }} focus-inset"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.button_label | escape }}
          </a>
      {%- endcase -%}
    {%- endfor -%}
    <div class="help-allcontain">
      <div class="help-contain1">
        <a href="{{ section.settings.help-link1 }}" class="help-imgbox1 wow animate__fadeInLeft" data-wow-duration="1.5s">
          <img
            class="help-img1"
            src="{{ section.settings.help-img1 }}"
            alt=""
          />
          <div class="help-textbox1">
            <div class="help-texttitle">{{ section.settings.help-title1 }}</div>
            <div class="help-textdes">{{ section.settings.help-des1 }}</div>
          </div>
        </a>
        <div class="help-box1">
          <a href="{{ section.settings.help-link2 }}" class="help-imgbox1 wow animate__fadeInLeft" data-wow-duration="3s">
            <img
              class="help-img2"
              src="{{ section.settings.help-img2 }}"
              alt=""
            />
            <div class="help-textbox1">
              <div class="help-texttitle">
                {{ section.settings.help-title2 }}
              </div>
              <div class="help-textdes">{{ section.settings.help-des2 }}</div>
            </div>
          </a>
          <a href="{{ section.settings.help-link3 }}" class="help-imgbox1 wow animate__fadeInLeft" data-wow-duration="2s">
            <img
              class="help-img2"
              src="{{ section.settings.help-img3 }}"
              alt=""
            />
            <div class="help-textbox1">
              <div class="help-texttitle">
                {{ section.settings.help-title3 }}
              </div>
              <div class="help-textdes">{{ section.settings.help-des3 }}</div>
            </div>
          </a>
        </div>
      </div>
      <div class="help-contain2">
        <a href="{{ section.settings.help-link4 }}" class="help-imgbox1 wow animate__fadeInRight" data-wow-duration="1.5s">
          <img
            class="help-img1"
            src="{{ section.settings.help-img4 }}"
            alt=""
          />
          <div class="help-textbox1">
            <div class="help-texttitle">{{ section.settings.help-title4 }}</div>
            <div class="help-textdes">{{ section.settings.help-des4 }}</div>
          </div>
        </a>
        <div class="help-box1">
          <a href="{{ section.settings.help-link5 }}" class="help-imgbox1 wow animate__fadeInRight" data-wow-duration="2s">
            <img
              class="help-img2"
              src="{{ section.settings.help-img5 }}"
              alt=""
            />
            <div class="help-textbox1">
              <div class="help-texttitle">
                {{ section.settings.help-title5 }}
              </div>
              <div class="help-textdes">{{ section.settings.help-des5 }}</div>
            </div>
          </a>
          <a href="{{ section.settings.help-link6 }}" class="help-imgbox1 wow animate__fadeInRight" data-wow-duration="3s">
            <img
              class="help-img2"
              src="{{ section.settings.help-img6 }}"
              alt=""
            />
            <div class="help-textbox1">
              <div class="help-texttitle">
                {{ section.settings.help-title6 }}
              </div>
              <div class="help-textdes">{{ section.settings.help-des6 }}</div>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
              <script>
              new WOW().init();
              </script>
