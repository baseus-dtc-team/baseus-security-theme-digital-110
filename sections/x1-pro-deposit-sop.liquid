{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}
  <style>
    .breadcrumb {
      display: none;
    }
    .deposit-contain {
      background: linear-gradient(to right, #010100, #2b2e32 50%, #010100);
      color: #ffffff;
      padding: 30px 0;
    }
    .deposit-contain h2 {
      font-size: 28px;
      color: #ffffff;
    }
    .deposit-contain p {
      font-size: 18px;
      color: #ffffff;
    }
    .deposit-box1 {
      padding: 50px 30px;
    }
    .deposit-title-box1 {
      margin-left: 5%;
      text-align: left;
    }
    .deposit-box1-imgs {
      display: flex;
      gap: 3%;
      justify-content: center;
    }
    .deposit-box1-imgs a {
      width: 25%;
      max-width: 330px;
    }
    .deposit-box1-imgs img {
      width: 100%;
    }
    .deposit-box2 {
      padding: 30px;
      display: flex;
      align-items: center;
      /* justify-content: center; */
    }
    .deposit-title-box2 {
      width: 60%;
      margin-left: 5%;
      text-align: left;
    }
    .deposit-box2-img {
      width: 40%;
      max-width: 280px;
    }
    .deposit-box1-imgsbox {
      width: 25%;
      display: flex;
      flex-direction: column;
      gap: 25px;
      align-items: center;
    }
    .deposit-box1-imgsbox a {
      background: #558dd5;
      width: 80%;
      display: block;
      padding: 10px;
      border-radius: 8px;
      text-align: center;
      font-weight: bold;
      text-decoration: none;
      color: #ffffff;
      font-size: 26px;
    }
    .deposit-head-title {
      padding: 30px 0;
      margin-top: 40px;
      font-size: 36px;
      font-weight: bold;
      text-align: center;
    }
    .deposit-head-des {
      text-align: center;
      font-size: 18px;
    }
    .deposit-head-des a {
      color: #ffffff;
      text-decoration: underline;
    }
    @media screen and (max-width: 750px) {
      .deposit-contain h2 {
        font-size: 20px;
      }
      .deposit-contain p {
        font-size: 14px;
      }
      .deposit-box1 {
        padding: 20px;
      }
      .deposit-box1-imgs {
        gap: 10px;
        flex-wrap: wrap;
      }
      .deposit-box1-imgs a {
        width: 45%;
      }
      .deposit-box2 {
        padding: 20px;
        flex-direction: column;
      }
      .deposit-title-box1 {
        margin-left: unset;
      }
      .deposit-title-box2 {
        width: 100%;
        margin-left: unset;
      }
      .deposit-box2-img {
        width: 90%;
      }
      .deposit-box1-imgsbox {
        width: 48%;

        gap: 15px;
      }
      .deposit-box1-imgsbox a {
        width: 80%;
        padding: 6px;
        font-size: 18px;
      }
      .deposit-head-title {
        padding: 20px 0;
        margin-top: 30px;
        font-size: 26px;
      }
      .deposit-head-des {
        font-size: 14px;
      }
    }
  </style>
<div class="rich-text {% if section.settings.full_width %}rich-text--full-width {% else %}container{% endif %} rich-text--align-{{ section.settings.alignment }} shopify-n1-seewide">
  <div class="rich-text__blocks {% if section.settings.full_width %}container{% endif %} color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding n1-seewide-container">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'subheading' -%}
          <div
            class="rich-text__subheading subtitle"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.subheading | escape }}
          </div>
        {%- when 'heading' -%}
          <h2
            class="rich-text__heading title--section {% if block.settings.heading_size == 'medium' %}h2{% else %}h1{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.heading }}
          </h2>
        {%- when 'text' -%}
          <div class="compare__description description body-large  description--center" {{ block.shopify_attributes }} style="margin: auto;">
            {{ block.settings.text }}
          </div>
        {%- when 'button' -%}
          <a
            {% if block.settings.button_link == blank %}
              aria-disabled="true"
            {% else %}
              href="{{ block.settings.button_link }}"
            {% endif %}
            class="button button--{{ block.settings.button_style }} focus-inset"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.button_label | escape }}
          </a>
      {%- endcase -%}
    {%- endfor -%}
