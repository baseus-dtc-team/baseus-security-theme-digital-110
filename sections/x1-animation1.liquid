    <script>
window.addEventListener('load', function() {
  // 所有资源(包括图片)加载完成后再计算 
      let screenWidth = window.screen.width
      {% comment %} let head1 = document.querySelector('.announcement-bar').offsetHeight;
      let header2 = document.querySelector('.shopify-section-header').offsetHeight;
      let topslide = document.querySelector('.x1-slideshow-container').offsetHeight;
      let topmulti = document.querySelector('.x1-grid-section').offsetHeight; {% endcomment %}
      let topemail = document.querySelector('.vr2-anchor-content').offsetHeight;       
      let distop1 = document.querySelector('.animationcontain1').getBoundingClientRect().top;  
      var showtime1 = document.getElementById("canvasbox1");
      var showfixed1 = document.getElementById("canvasfixed1");
      if(screenWidth>750){var c1 = document.getElementById("background1");}else{var c1 = document.getElementById("background12");}
      var ctx1 = c1.getContext("2d");
      var protitle11 = document.getElementById("pro-title11");
      var protitle12 = document.getElementById("pro-title12");
      var protitle13 = document.getElementById("pro-title13");
      var protitle14 = document.getElementById("pro-title14");      
      var protitle15 = document.getElementById("pro-title15");           
      var images1 = new Array();
      var abc1 = 1;
      var funTip1 = 0;
      if(screenWidth>750){
        var totalImages1 = 364;
      for (var i = 1; i < totalImages1; i++) {
        var img = new Image();
        var slug = "000" + i;
        img.src =
          "https://cdn.shopify.com/s/files/1/0555/8432/5709/files/x1-lens-introduce-0" + slug.slice(-3) + ".jpg";
        images1.push(img);
      }
    }else{
      var totalImages1 = 364;
      for (var i = 1; i < totalImages1; i++) {
        var img = new Image();
        var slug = "000" + i;
        img.src =
          "https://cdn.shopify.com/s/files/1/0555/8432/5709/files/x1mo-lens-introduce-0" + slug.slice(-3) + ".jpg";
        images1.push(img);
      }
    }
      setTimeout(() => {
          ctx1.fillRect(0, 0, c1.width, c1.height- topemail);
          ctx1.drawImage(images1[1], 0, 0, c1.width, c1.height- topemail);
      }, 200);
      function swiper(e) {
        funTip1 = 1;
        var scrollTop =
          (window.pageYOffset || document.documentElement.scrollTop) - distop1
        if(screenWidth > 750){
          if (parseInt(scrollTop / 10) < 1) {
          abc1 = 1;
        } else {
          abc1 = parseInt(scrollTop / 10);
        } 
        if (abc1 < 20) {
          protitle11.style.display = "block";
        if (abc1 > 5 && abc1 <= 15){
          protitle11.style.opacity = 1 - (abc1 - 5) / 10;          
        }  
        }else if (abc1 >= 25 && abc1 < 40) {
          protitle12.style.display = "block";
          protitle12.style.opacity = (abc1 - 25) / 5;
        }else if (abc1 >= 50 && abc1 < 65) {
          protitle13.style.display = "block";
          protitle13.style.opacity = (abc1 - 50) / 5;
        }else if (abc1 >= 75 && abc1 < 95) {
          protitle14.style.display = "block";
          protitle14.style.opacity = (abc1 - 75) / 5;
        }else if (abc1 >= 230 && abc1 < 370) {
          protitle15.style.display = "block";
          protitle15.style.opacity = (abc1 - 230) / 10;
        }  else {
          // protitle11.style.opacity = 0;
          protitle12.style.opacity = 0;
          protitle13.style.opacity = 0;
          protitle14.style.opacity = 0;   
          protitle15.style.opacity = 0;   
              protitle11.style.display = "none";
              protitle12.style.display = "none";
              protitle13.style.display = "none";
              protitle14.style.display = "none";    
              protitle15.style.display = "none";  
        }
        if (abc1 <= 359) {
          ctx1.fillRect(0, 0, c1.width, c1.height);
          ctx1.drawImage(images1[abc1], 0, 0, c1.width, c1.height);
        }
        }else{
         if (parseInt(scrollTop / 10) < 1) {
          abc1 = 1;
        } else {
          abc1 = parseInt(scrollTop / 10);
        }
        
        if (abc1 < 20) {
          protitle11.style.display = "block";
        if (abc1 > 5 && abc1 <= 15){
          protitle11.style.opacity = 1 - (abc1 - 5) / 10;          
        }  
        }else if (abc1 >= 25 && abc1 < 40) {
          protitle12.style.display = "block";
          protitle12.style.opacity = (abc1 - 25) / 5;
        }else if (abc1 >= 50 && abc1 < 65) {
          protitle13.style.display = "block";
          protitle13.style.opacity = (abc1 - 50) / 5;
        }else if (abc1 >= 75 && abc1 < 95) {
          protitle14.style.display = "block";
          protitle14.style.opacity = (abc1 - 75) / 5;
        }else if (abc1 >= 230 && abc1 < 370) {
          protitle15.style.display = "block";
          protitle15.style.opacity = (abc1 - 230) / 10;
        }  else {
          // protitle11.style.opacity = 0;
          protitle12.style.opacity = 0;
          protitle13.style.opacity = 0;
          protitle14.style.opacity = 0;   
          protitle15.style.opacity = 0;   
              protitle11.style.display = "none";
              protitle12.style.display = "none";
              protitle13.style.display = "none";
              protitle14.style.display = "none";    
              protitle15.style.display = "none";  
        }
        if (abc1 <= 359) {
          ctx1.fillRect(0, 0, c1.width, c1.height);
          ctx1.drawImage(images1[abc1], 0, 0, c1.width, c1.height);
        } 
        }
        if(screenWidth>750){var screenHeigt = 1080 - 146}else{var screenHeigt = 844}
        if (
          document.documentElement.scrollTop >=
          distop1 + 4680 - screenHeigt
        ) {
          showfixed1.style.position = "absolute";
          showfixed1.style.bottom = "0";
          showfixed1.style.top = "auto";
        } else {
          showfixed1.style.position = "fixed";
        if(screenWidth>750){
          showfixed1.style.top = topemail + "px";
        }else{
          showfixed1.style.top = 0 + "px";
        }                    
          showfixed1.style.bottom = "auto";
        }
      }
      // var advanceShow1 = `-${c1.height - head1 - header2}px`
      var observer1 = new IntersectionObserver(
        (entries) => {
          entries.forEach((i) => {
            // 通过滚动判断是否是当前的监听对象
            if (i.isIntersecting) {
              showfixed1.style.position = "fixed";
              protitle11.style.display = "block"
              protitle12.style.display = "block"
              protitle13.style.display = "block"
              protitle14.style.display = "block"  
              protitle15.style.display = "block"               
              console.log("出现");
              window.onscroll = swiper;
              return;
            } else {
              showfixed1.style.position = "unset";
              protitle11.style.display = "none"
              protitle12.style.display = "none"
              protitle13.style.display = "none"
              protitle14.style.display = "none"  
              protitle15.style.display = "none"               
              console.log("消失");
              if (funTip1 > 0) {
                window.onscroll = undefined;
              }
              return;
            }
          });
        },
          {
          rootMargin: screenWidth > 1000 ? `0px 0px -1080px 0px` : "0px 0px -712px 0px", // 提前150px进入可视区域时就加载图片，提高用户体验
            // rootMargin: "0px 0px " + advanceShow1 + " 0px"
        }  
      );
      // observer1.observe(showtime1);
      function addEvent1(obj,type,fn){
    if(obj.attachEvent){ //ie
        obj.attachEvent('on'+type,function(){
            fn.call(obj);
        })
    }else{
        obj.addEventListener(type,fn,false);
    }
}
addEvent1(window,'scroll',function(){
          var scrollTopShow = (window.pageYOffset || document.documentElement.scrollTop)
      if(scrollTopShow < distop1 + 4680 ){
         observer1.observe(showtime1);
      }else{
        observer1.unobserve(showtime1);
        showfixed1.style.position = "unset";
      }
});
      window.onbeforeunload = function () {
        //刷新后页面自动回到顶部
        document.documentElement.scrollTop = 0; //ie下
        document.body.scrollTop = 0; //非ie
      };
      });      
    </script>
