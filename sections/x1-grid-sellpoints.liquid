{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}
  <style>
    .s2-grid-sellpoints-head {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin: 30px;
      text-align: center;
    }
    .s2-grid-sellpoints-headtitle {
      font-size: 34px;
      font-weight: bold;
      margin: 10px 0;
    }
    .s2-grid-sellpoints-subhead {
      font-size: 24px;
    }
    .s2-grid-sellpoints-content {
      display: flex;
      gap: 10px;
      width: 100%;
      background: linear-gradient(to right, #010100, #2b2e32 50%, #010100);
      max-width: 1500px;
    }
    .s2-grid-sellpoints-zongbox {
      width: 50%;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .s2-grid-sellpoints-boxs {
      position: relative;
    }
    .s2-grid-sellpoints-title {
      position: absolute;
      width: 100%;
      text-align: center;
      font-size: 1.8vw;
      color: #000000;
      font-weight: bold;
    }
    .s2-grid-sellpoints-bgimgs {
      width: 100%;
      border-radius: 10px;
    }
    .s2-grid-text1 {
      top: 5%;
      font-size: 2vw;
      line-height: 2.3vw;
      text-align: left;
      left: 5%;
      font-weight: bold;
      color: #000000;
      line-height: 2.5vw;
      width: 90%;
    }
    .s2-grid-text4 span {
      display: block;
      font-size: 1.2vw;
      color: #555555;
    }
    .s2-grid-text2 {
      top: 5%;
      left: 5%;
      font-size: 2vw;
      line-height: 2.3vw;
      width: 90%;
      text-align: left;
      font-weight: bold;
      /* color: #ffffff; */
    }
    .s2-grid-text3 {
      width: max-content;
      top: 10%;
      left: 10%;
    }
    .s2-grid-text3-des {
      font-weight: bold;
    }
    .s2-grid-text4 {
      top: 7%;
      line-height: 2vw;
    }
    .s2-grid-text4-des {
      font-weight: bold;
      font-size: 3.5vw;
    }
    .s2-grid-sellpoints-boxs2 {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .s2-grid-sellpoints-smallbox {
      width: calc(50% - 5px);
    }
    .s2-grid-centertext {
      font-size: 1.5vw;
    }
    .s2-grid-centertext span {
      font-size: 1.8vw;
      color: #ffffff;
    }
    .s2-grid-bottomtext {
      top: unset;
      bottom: 10%;
    }
    .zongbox1 {
      width: 35.5%;
    }
    .zongbox2 {
      width: 41.7%;
    }
    .zongbox3 {
      width: 23.5%;
    }
    .grid-pc-show {
      display: flex;
    }
    .grid-mo-show {
      display: none;
    }
    .x1-grid-section {
    margin: 0;
    display: flex;
    justify-content: center;  
    background: linear-gradient(to right, #010100, #2b2e32 50%, #010100);
    z-index: 1;
    position: relative;
    padding: 50px 30px;
    }
    @media screen and (min-width: 1700px) {
    .s2-grid-text1 {
    font-size: 36px;
    line-height: 40px;
    }
    .s2-grid-text2 {
      font-size: 36px;
      line-height: 40px;
    }
    .s2-grid-sellpoints-title {
    font-size: 34px;
    line-height: 38px;
    }   
    }
    @media screen and (max-width: 750px) {
      .s2-grid-sellpoints-headtitle {
        font-size: 30px;
      }
      .s2-grid-sellpoints-subhead {
        font-size: 18px;
        width: 100%;
      }
      .s2-grid-centertext span {
        font-size: 30px;
      }
      .s2-grid-sellpoints-content {
        flex-direction: column;
        gap: 10px;
        padding: 0 20px;
      }
      .s2-grid-sellpoints-zongbox {
        width: 100%;
      }
      .s2-grid-text1 {
        top: 10%;
        font-size: 20px;
        line-height: 24px;
        width: 100%;
      }
      .s2-grid-text4 span {
        font-size: 16px;
      }
      .s2-grid-text1 span {
        font-size: 16px;
      }      
      .s2-grid-text2 {
        top: 10%;
        font-size: 24px;
        line-height: 28px;
        width: 100%;
      }
      .s2-grid-sellpoints-title {
        font-size: 22px;
        line-height: 26px;
      }
      .s2-grid-text4-des {
        font-size: 34px;
      }
      .grid-pc-show {
        display: none;
      }
      .grid-mo-show {
        display: flex;
      }
     .x1-grid-section {
    padding: 30px 0px;
    }     
    }
  </style>
