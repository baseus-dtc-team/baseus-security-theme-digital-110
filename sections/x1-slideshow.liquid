     <script>
      window.onbeforeunload = function () {
        //刷新后页面自动回到顶部
        document.documentElement.scrollTop = 0; //ie下
        document.body.scrollTop = 0; //非ie
      };        
      document.addEventListener("DOMContentLoaded", function () {
        {% comment %} const scalableImage = document.querySelector(".scalable-image"); {% endcomment %}
        const hiddenContent = document.querySelector(".hidden-content");
        const carouselContainer = document.querySelector(
          ".hidden-content-text"
        );
        const hiddenContentid = document.querySelector(".hidden-content-id");

        // 图片初始缩放比例
        let scale = 1;
  
        window.addEventListener("scroll", function () {
  let head = document.querySelector('.email-row'); 
  let head1 = document.querySelector('.announcement-bar').offsetHeight;
  let head2 = document.querySelector('.shopify-section-header').offsetHeight;
  let head3 = document.querySelector('.x1-slideshow-container').offsetHeight; 
  let announcementbar = document.querySelector('.announcement-bar')
  let headerbar = document.querySelector('.shopify-section-header')        
  var topEmail = document.querySelector('.vr2-anchor-content')              
   var scrollTop = window.pageYOffset || document.documentElement.scrollTop || document.body.scrollTop
  let screenWidth0 = window.screen.width   
    if(screenWidth0 > 750){
    if (scrollTop >= head1 + head2 + head3 + head2) {
      topEmail.style.display = 'flex'
	  topEmail.style.top = 0 + 'px'
      announcementbar.style.visibility = 'hidden'
      headerbar.style.visibility = 'hidden'
    }else{
    topEmail.style.display = 'none'  
    announcementbar.style.visibility = 'visible'
    headerbar.style.visibility = 'visible'
	}      
    }

          
          {% comment %} // 获取滚动位置
          const scrollY = window.scrollY || window.pageYOffset;
          if (scrollY <= carouselContainer.offsetTop + head1 + head2 + 80) {
            hiddenContent.style.zIndex = "1";
            hiddenContent.style.display = "flex"
          } else {
            hiddenContent.style.zIndex = "-1";
            hiddenContent.style.display = "none"
          }
          // 计算新的缩放比例（随滚动增加）
          scale = 1 + scrollY * 0.009;

          // 限制最大缩放比例
          //   scale = Math.min(scale, maxScale);

          // 应用缩放
          scalableImage.style.transform = `scale(${scale})`;

          // 计算透明度（随着缩放增加而减小）
          const opacity = scrollY * 0.001;

          if (opacity > 1) {
            scalableImage.style.zIndex = "-1";
            hiddenContentid.style.opacity = opacity - 1;
          } else {
            scalableImage.style.zIndex = "3";
            hiddenContentid.style.opacity = 0;
          } {% endcomment %}
        });
      });
    </script>
