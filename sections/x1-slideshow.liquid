  <style>
  .x1-slideshow-container {
    padding: 0;
    margin: 0;
    max-width: none;
  }
     /* 图片容器样式 */
      .image-container {
        position: relative;
        width: 100%;
        /* height: 100vh; */
        overflow: hidden;
        display: flex;
        justify-content: center;
        align-items: center;
        /* background: #000; */
        flex-direction: column;
        padding-top: calc(100vh);
      }

      /* 可缩放图片样式 */
      .scalable-image {
        width: 100%;
        /* height: 100%; */
        /* object-fit: cover; */
        transform-origin: center 70%;
        will-change: transform; /* 优化性能 */
        position: fixed;
        top: 0;
        top: 0;
        margin: auto;
        bottom: 0;
        z-index: 4;
        height: 100vh;
        width: auto;
        max-width: none;
        z-index: -1;
      }

      /* 隐藏在图片下方的内容 */
      .hidden-content {
        position: fixed;
        width: 100%;
        /* min-height: 100vh; */
        /* padding: 40px;
        background: pink; */
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        opacity: 1;
        transition: opacity 0.5s ease;
        bottom: 0;
        background: #000000;
        z-index: 0;
      }
      .hidden-content-id {
        {% comment %} opacity: 0; {% endcomment %}
        position: absolute;
        top: 40%;
        left: 15%;
        color: #ffffff;
      }
      .hidden-content-id h1 {
      font-size: 32px;
      line-height: 38px;
      color: #ffffff;
      }
      .hidden-content-id p {
      font-size: 20px;
      color: #ffffff;
      }
      /* 显示后的内容样式 */
      .hidden-content.visible {
        opacity: 0;
      }

      /* 仅用于演示的额外内容 */
      .demo-content {
        padding: 40px;
        text-align: center;
        height: 100vh;
      }

      .hidden-content-text {
        /* height: 100vh; */
        width: 100vw;
        position: sticky;
        top: 0;
        z-index: 2;
        background: transparent;
      }
      .x1-pc-banner {
     transform-origin: center center;
    will-change: auto;
    width: auto;
    height: calc(100vh);
    max-width: none;
      }
    .pc-show {
      display: block;
    }
    .mo-show {
      display: none;
    }
    .section1-box5 {
