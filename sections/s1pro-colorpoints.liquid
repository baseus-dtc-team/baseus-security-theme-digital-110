{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}
  <style>
    .s1pro-color-contant {
      display: flex;
    }
    .s1pro-color-textbox {
      width: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .s1pro-color-textboxs {
      display: flex;
      flex-direction: column;
      gap: 10px;
      text-align: left;
    }
    .s1pro-color-title {
      font-size: 30px;
      font-weight: bold;
    }
    .s1pro-color-des {
      font-size: 18px;
    }
    .s1pro-color-iconcontent {
      display: flex;
      gap: 20px;
    }
    .s1pro-color-iconbox {
      text-align: center;
    }
    .s1pro-color-iconimg {
      width: 60px;
    }
    .s1pro-color-icontext {
      font-size: 16px;
    }
    .s1pro-color-bgimgbox {
      width: 50%;
    }
    .s1pro-color-bgimg {
      width: 100%;
    }
    .s1pro-colorpoints-content {
      padding: 0;
      margin: 0;
      max-width: none;      
    }

    @media screen and (max-width: 750px) {
      .s1pro-color-contant {
        flex-direction: column;
      }
      .s1pro-color-textbox {
        width: 100%;
        margin: 20px 0;
      }
      .s1pro-color-textboxs {
        align-items: center;
        text-align: center;
      }
      .s1pro-color-title {
        font-size: 24px;
      }
      .s1pro-color-des {
        font-size: 16px;
      }
      .s1pro-color-iconimg {
        width: 40px;
      }
      .s1pro-color-bgimgbox {
        width: 100%;
      }
    }
  </style>
<div class="rich-text {% if section.settings.full_width %}rich-text--full-width {% else %}container{% endif %} rich-text--align-{{ section.settings.alignment }}">
  <div class="rich-text__blocks {% if section.settings.full_width %}container{% endif %} color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding s1pro-colorpoints-content">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'subheading' -%}
          <div
            class="rich-text__subheading subtitle"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.subheading | escape }}
          </div>
        {%- when 'heading' -%}
          <h2
            class="rich-text__heading title--section {% if block.settings.heading_size == 'medium' %}h2{% else %}h1{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.heading }}
          </h2>
        {%- when 'text' -%}
          <div class="rich-text__text" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </div>
        {%- when 'button' -%}
          <a
            {% if block.settings.button_link == blank %}
              aria-disabled="true"
            {% else %}
              href="{{ block.settings.button_link }}"
            {% endif %}
            class="button button--{{ block.settings.button_style }} focus-inset"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.button_label | escape }}
          </a>
      {%- endcase -%}
    {%- endfor -%}
    <div class="s1pro-color-contant">
      <div class="s1pro-color-textbox">
        <div class="s1pro-color-textboxs">
          <div class="s1pro-color-title">
            Advanced Night <br />
            Protection in Color
          </div>
          <div class="s1pro-color-des">
            Color night vision improves the image <br />
            quality in low-light situations for <br />
            better night protection.
          </div>
          <div class="s1pro-color-iconcontent">
            <div class="s1pro-color-iconbox">
              <img
                class="s1pro-color-iconimg"
                src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_S1_Pro_Outdoor_Camera_icon-01_f0ebcd95-7c37-49f8-a866-5ae33b32a969.png?v=1744600110"
                alt=""
              />
              <div class="s1pro-color-icontext">
                100LM <br />
                Spotlight
              </div>
            </div>
            <div class="s1pro-color-iconcontent">
              <div class="s1pro-color-iconbox">
                <img
                  class="s1pro-color-iconimg"
                  src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_S1_Pro_Outdoor_Camera_icon-02_7948c39c-0f54-4e95-a689-f34c63bbe888.png?v=1744600111"
                  alt=""
                />
                <div class="s1pro-color-icontext">
                  Smart Trigger<br />
                  Reminder
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="s1pro-color-bgimgbox">
        <img
          class="s1pro-color-bgimg"
          src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_S1_Pro_Outdoor_Camera02.jpg?v=1744600105"
          alt=""
        />
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "s1pro-colorpoints",
  "tag": "section",
  "class": "spaced-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "t:sections.rich-text.settings.full_width.label"
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.rich-text.settings.alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.rich-text.settings.alignment.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "m",
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "m",
      "label": "t:sections.all.section-padding.padding_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "subheading",
      "name": "t:sections.rich-text.blocks.subheading.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "default": "Subheading",
          "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:sections.rich-text.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Heading for your section",
          "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "medium",
              "label": "t:sections.rich-text.blocks.heading.settings.heading_size.options__1.label"
            },
            {
              "value": "large",
              "label": "t:sections.rich-text.blocks.heading.settings.heading_size.options__2.label"
            }
          ],
          "default": "medium",
          "label": "t:sections.rich-text.blocks.heading.settings.heading_size.label"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.rich-text.blocks.text.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Description for your section.</p>",
          "label": "t:sections.rich-text.blocks.text.settings.text.label"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.rich-text.blocks.button.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "default": "Button label",
          "label": "t:sections.all.button.button_label.label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.all.button.button_link.label"
        },
        {
          "type": "select",
          "id": "button_style",
          "options": [
            {
              "value": "primary",
              "label": "t:sections.all.button.button_style.options__1.label"
            },
            {
              "value": "secondary",
              "label": "t:sections.all.button.button_style.options__2.label"
            },
            {
              "value": "tertiary",
              "label": "t:sections.all.button.button_style.options__3.label"
            }
          ],
          "default": "primary",
          "label": "t:sections.all.button.button_style.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "s1pro-colorpoints",
      "blocks": [
        {
          "type": "subheading"
        },
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
