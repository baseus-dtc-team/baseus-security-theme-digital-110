{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}
  <style>
    .s2-prodetail-allcontent {
      display: flex;
      flex-direction: column;
      gap: 20px;
      align-items: center;
    }
    .s2-prodetail-content {
      width: 100%;
      position: relative;
      max-width: 1000px;
    }
    .s2-prodetail-titlebox {
      position: absolute;
      top: 30%;
      left: 6%;
      z-index: 2;
      width: 50%;
      text-align: left;
    }
    .s2-prodetail-title {
      font-weight: bold;
      font-size: 32px;
      margin-bottom: 10px;
    }
    .s2-prodetail-des {
      font-size: 18px;
    }
    .s2-prodetail-mainimg {
      width: 100%;
      border-radius: 20px;
    }
    .s2-prodetail-btntip {
      position: absolute;
      bottom: 30px;
      left: 6%;
      width: 50%;
      text-align: left;
    }
    .s2-prodetail-btnboxs {
      display: flex;
      gap: 20px;
    }
    .s2-prodetail-btnbox {
      text-align: center;
    }
    .s2-prodetail-btmdes {
      font-size: 16px;
    }
    .s2-prodetail-btnimg {
      width: 35px;
    }
    .s2-prodetail-color {
      color: #ffffff;
    }
    .s2-prodetail-videotip {
      top: 160px;
    }
    @media screen and (max-width: 750px) {
      .s2-prodetail-titlebox {
        position: unset;
        width: 100%;
        text-align: center;
        margin: 20px 0;
        color: #000000;
      }
      .s2-prodetail-title {
        font-size: 26px;
        margin-bottom: 5px;
      }
      .s2-prodetail-des {
        font-size: 16px;
      }
      .s2-prodetail-btntip {
        display: none;
        bottom: 30px;
        left: 20px;
        font-size: 12px;
      }
      .s2-prodetail-btmdes {
        font-size: 12px;
      }
      .s2-prodetail-videotip {
        top: auto;
        bottom: 20px;
      }
    }
  </style>
<div class="rich-text {% if section.settings.full_width %}rich-text--full-width {% else %}container{% endif %} rich-text--align-{{ section.settings.alignment }}">
  <div class="rich-text__blocks {% if section.settings.full_width %}container{% endif %} color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'subheading' -%}
          <div
            class="rich-text__subheading subtitle"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.subheading | escape }}
          </div>
        {%- when 'heading' -%}
          <h2
            class="rich-text__heading title--section {% if block.settings.heading_size == 'medium' %}h2{% else %}h1{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.heading }}
          </h2>
        {%- when 'text' -%}
          <div class="rich-text__text" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </div>
        {%- when 'button' -%}
          <a
            {% if block.settings.button_link == blank %}
              aria-disabled="true"
            {% else %}
              href="{{ block.settings.button_link }}"
            {% endif %}
            class="button button--{{ block.settings.button_style }} focus-inset"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.button_label | escape }}
          </a>
      {%- endcase -%}
    {%- endfor -%}
    <div class="s2-prodetail-allcontent">
      <div class="s2-prodetail-content">
        <div class="s2-prodetail-titlebox">
          <div class="s2-prodetail-title">Enhanced Security <br /> 
            & Privacy Protection</div>
          <div class="s2-prodetail-des">
            • AES + RSA Dual Encryption  <br />
            • CCPA Privacy Compliant  <br />
            • AI On-Devic
          </div>
        </div>
        <img
          class="s2-prodetail-mainimg"
          src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_S2_Outdoor_Camera_4K_01_e6f4a6b8-7eb2-4eb3-b2f8-6f4f86bce5e3.jpg?v=1751958905"
          alt=""
        />
        <!-- <div class="s2-prodetail-btntip">
          *Based on 10 seconds of video per recording, 30 recordings peday<br />
          *All data was provided by the Baseus Lab.
        </div> -->
      </div>
      <div class="s2-prodetail-content">
        <div class="s2-prodetail-titlebox">
          <div class="s2-prodetail-title">
            No Hidden Fees
          </div>
          <div class="s2-prodetail-des">
            Store your data securely on local <br />
            storage with no monthly <br />
            subscription fees. 
          </div>
        </div>
        <img
          class="s2-prodetail-mainimg"
          src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_S2_Outdoor_Camera_4K_02-0.jpg?v=1751958905"
          alt=""
        />
      </div>
      <div class="s2-prodetail-content">
        <div class="s2-prodetail-titlebox">
          <div class="s2-prodetail-title">Data Security with <br /> Local Storage</div>
          <div class="s2-prodetail-des">
            Support up to <br />
            <b>512GB</b> microSD card (not included).
          </div>
        </div>
        <img
          class="s2-prodetail-mainimg"
          src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_S2_Outdoor_Camera_4K_03_aae7eac6-092d-4114-b480-37d1b0da1651.jpg?v=1751958905"
          alt=""
        />
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "s2-sellpoints-img",
  "tag": "section",
  "class": "spaced-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "t:sections.rich-text.settings.full_width.label"
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.rich-text.settings.alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.rich-text.settings.alignment.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "m",
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "m",
      "label": "t:sections.all.section-padding.padding_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "subheading",
      "name": "t:sections.rich-text.blocks.subheading.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "default": "Subheading",
          "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:sections.rich-text.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Heading for your section",
          "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "medium",
              "label": "t:sections.rich-text.blocks.heading.settings.heading_size.options__1.label"
            },
            {
              "value": "large",
              "label": "t:sections.rich-text.blocks.heading.settings.heading_size.options__2.label"
            }
          ],
          "default": "medium",
          "label": "t:sections.rich-text.blocks.heading.settings.heading_size.label"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.rich-text.blocks.text.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Description for your section.</p>",
          "label": "t:sections.rich-text.blocks.text.settings.text.label"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.rich-text.blocks.button.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "default": "Button label",
          "label": "t:sections.all.button.button_label.label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.all.button.button_link.label"
        },
        {
          "type": "select",
          "id": "button_style",
          "options": [
            {
              "value": "primary",
              "label": "t:sections.all.button.button_style.options__1.label"
            },
            {
              "value": "secondary",
              "label": "t:sections.all.button.button_style.options__2.label"
            },
            {
              "value": "tertiary",
              "label": "t:sections.all.button.button_style.options__3.label"
            }
          ],
          "default": "primary",
          "label": "t:sections.all.button.button_style.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "s2-sellpoints-img",
      "blocks": [
        {
          "type": "subheading"
        },
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
