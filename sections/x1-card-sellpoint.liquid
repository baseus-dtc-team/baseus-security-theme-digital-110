{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}
  <style>
    .x1-card-content {
      display: flex;
      width: 100%;
      gap: 4%;
      text-align: center;
      {% comment %} background: linear-gradient(to right, #010100, #2b2e32 50%, #010100); {% endcomment %}
      padding: 50px 30px;
      max-width: 1500px;
      position: relative;
      z-index: 1;
    }
    .x1-card-boxs {
      width: 100%;
      color: #575757;
    }
    .x1-card-boxs.active {
      color: #ffffff;
    }
    .x1-card-imgs {
      width: 100%;
      transition: all 0.6s;
      border-radius: 12px;
    }
    .x1-card-boxs.active .x1-card-imgs {
      transform: scale(1.1);
    }
    .x1-card-textbox {
    }
    .x1-card-text-title {
      font-size: 20px;
      font-weight: bold;
      margin-top: 20px;
    }
    .x1-card-text-des {
      font-size: 14px;
    }
    .x1-card-section {
    margin: 0;
    display: flex;
    justify-content: center;
    background: linear-gradient(to right, #010100, #2b2e32 50%, #010100); 
    }
    @media screen and (max-width: 750px) {
      .x1-card-content {
        overflow: auto;
        gap: 5vw;
      }
      .x1-card-imgs {
        width: 60vw;
      }

      .x1-card-boxs.active .x1-card-imgs {
        {% comment %} transform: none; {% endcomment %}
      }
      .x1-card-boxs {
        width: 60vw;
        max-width: 400px;
        flex-shrink: 0;
      }
      .x1-card-text-title { 
        font-size: 16px;
        line-height: 20px;
      }
      .x1-card-text-des {
        margin-top: 5px;
      }
    }
  </style>
<div class="rich-text {% if section.settings.full_width %}rich-text--full-width {% else %}container{% endif %} rich-text--align-{{ section.settings.alignment }}">
  <div class="rich-text__blocks {% if section.settings.full_width %}container{% endif %} color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">  
    <div class="x1-card-content">
      {%- for block in section.blocks -%}
      <div
        class="x1-card-boxs"
        onmouseenter="expandModule(this)"
        onmouseleave="resetModules()"
      >
        <img 
          class="x1-card-imgs"
          src="{{ block.settings.image | image_url }}"
          alt=""
        />
        <div class="x1-card-textbox">
          <div class="x1-card-text-title">
            {{ block.settings.text }}
          </div>
          {% comment %} <div class="x1-card-text-des">Protect two yards simultaneously.</div> {% endcomment %}
        </div>
      </div>
      {%- endfor -%}
      {% comment %} <div
        class="x1-card-boxs active"
        onmouseenter="expandModule(this)"
        onmouseleave="resetModules()"
      >
        <img
          
          class="x1-card-imgs"
          src="{{ section.settings.text4 }}"
          alt=""
        />
        <div class="x1-card-textbox">
          <div class="x1-card-text-title">
            {{ section.settings.text5 }}<br />
            {{ section.settings.text6 }}
          </div>
          {% comment %} <div class="x1-card-text-des">Unified, seamless motion tracking.</div> {% endcomment %}
        </div>
      </div>
      <div
        class="x1-card-boxs"
        onmouseenter="expandModule(this)"
        onmouseleave="resetModules()"
      >
        <img
          
          class="x1-card-imgs"
          src="{{ section.settings.text7 }}"
          alt=""
        />
        <div class="x1-card-textbox">
          <div class="x1-card-text-title">
            {{ section.settings.text8 }}<br />
            {{ section.settings.text9 }}
          </div>
          {% comment %} <div class="x1-card-text-des">
            Singular comprehensive motion tracking.
          </div> {% endcomment %}
        </div> {% endcomment %}
    <script>
      if (window.innerWidth <= 750) {
        const picmodules = document.querySelectorAll(".x1-card-boxs");
        console.log(picmodules,'picmodules')
        picmodules[0].classList.add("active")        
        {% comment %} const element = document.querySelector(".x1-card-content");
        element.scrollLeft = window.innerWidth * 0.45; {% endcomment %}
      }
      function expandModule(module) {
        // Get all modules
        const modules = document.querySelectorAll(".x1-card-boxs");

        // Add active class to hovered module
        module.classList.add("active");

        // Add inactive class to other modules
        modules.forEach((m) => {
          if (m !== module) {
            m.classList.remove("active");
          }
        });
      }

      function resetModules() {
        // Remove all active/inactive classes
        const modules = document.querySelectorAll(".x1-card-boxs");
        modules.forEach((m) => {
          m.classList.remove("active");
          //   m.classList.remove("inactive");
        });
      }
    </script>    
  </div>
</div>
  </div>
</div>
