    <script>
      function toggleTable() {
        // const table = document.getElementById("toggleTable");
        const button = document.querySelector(".toggle-btn-text");
        const tableclass = document.querySelectorAll(".tableclass");
        const toggleimg = document.querySelector(".toggle-btn-img");

        if (button.textContent == "View ALL") {
          for (let i = 0; i < tableclass.length; i++) {
            tableclass[i].classList.remove("hidden");
          }
          // table.classList.remove("hidden");
          button.textContent = "Pack Up";
          toggleimg.style.transform = "rotate(180deg)";
        } else {
          for (let i = 0; i < tableclass.length; i++) {
            tableclass[i].classList.add("hidden");
          }
          // table.classList.add("hidden");
          button.textContent = "View ALL";
          toggleimg.style.transform = "rotate(0deg)";
        }
      }
    </script>
