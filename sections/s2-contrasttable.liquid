  {% render 'section-margin' %}
{%- endstyle -%}
    <style>
      table {
        border-collapse: collapse;
        /* width: 100%; */
        margin: 30px;
      }
      table.borderless {
        border: none;
        margin-top: -90px;
      }
      table.borderless td,
      table.borderless th {
        border: none;
        padding: 20px 10px;
        text-align: center;
        width: 20%;
        font-size: 16px;
      }
      .borderless tr {
        border-bottom: 1px solid #939393;
      }
      .toggle-btn {
        padding: 24px 16px;
        border-radius: 4px;
        cursor: pointer;
        background: transparent;
        font-size: 18px;
        font-weight: bold;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        width: max-content;
      }
      .toggle-btn-text {
        margin-right: 8px;
      }
      .toggle-btn-img {
        width: 24px;
      }
      .toggle-btn:hover {
        /* background-color: #45a049; */
      }
      .hidden {
        display: none;
      }
      .s1pro-contrast-content {
        display: flex;
        justify-content: center;
        flex-direction: column;
        background: #f6f6f6;
        border-radius: 10px;
        margin-top: 110px;
        align-items: center;        
      }
      .contrast-title {
        font-weight: bold;
        font-size: 20px !important;
      }
      .s1pro-contrast-probox {
        display: flex;
        flex-direction: column;
        gap: 10px;
        align-items: center;
      }
      .s1pro-contrast-imgs {
        width: 150px;
      }
      .s1pro-contrast-protitle {
        font-size: 18px;
        font-weight: bold;
      }
      .s1pro-contrast-proprice {
        font-size: 16px;
      }
      .s1pro-contrast-probtn {
        background: #fff101;
        border-radius: 90px;
        padding: 10px 30px;
        width: max-content;
        cursor: pointer;
        font-size: 16px;
        border: 1px solid #fff101;
        text-decoration: none;
      }
      .s1pro-contrast-probtn:hover {
        background: #000000;
        color: #ffffff;
        border: 1px solid #000000;
      }
      .s1pro-contrast-probtncolor {
        background: #ffffff;
        border: 1px solid #f2f2f2;
      }
      .s1pro-contrast-probox img {
        transition: all 0.6s;
      }
      .s1pro-contrast-probox img:hover {
        transform: scale(1.1);
      }

      @media screen and (max-width: 750px) {
        .s1pro-contrast-content {
          margin-top: 30px;
          width: 100%;
          overflow: scroll;
          justify-content: flex-start;
          align-items: flex-start;
        }
        table.borderless {
          margin-top: 0;
        }
        table.borderless td,
        table.borderless th {
          padding: 10px;
          font-size: 14px;
        }
        .contrast-title {
          font-size: 16px !important;
        }
        .s1pro-contrast-probox {
          width: 180px;
        }
        .s1pro-contrast-imgs {
          width: 120px;
        }
        .toggle-btn {
          padding: 16px;
        }
        table {
          margin: 10px;
        }
      }
    </style>
<div class="rich-text {% if section.settings.full_width %}rich-text--full-width {% else %}container{% endif %} rich-text--align-{{ section.settings.alignment }} shopify-n1-sellpoints">
  <div class="rich-text__blocks {% if section.settings.full_width %}container{% endif %} color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'subheading' -%}
          <div
            class="rich-text__subheading subtitle"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.subheading | escape }}
          </div>
        {%- when 'heading' -%}
          <h2
            class="rich-text__heading title--section {% if block.settings.heading_size == 'medium' %}h2{% else %}h1{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.heading }}
          </h2>
        {%- when 'text' -%}
          <div class="rich-text__text" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </div>
        {%- when 'button' -%}
          <a
            {% if block.settings.button_link == blank %}
              aria-disabled="true"
            {% else %}
              href="{{ block.settings.button_link }}"
            {% endif %}
            class="button button--{{ block.settings.button_style }} focus-inset"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.button_label | escape }}
          </a>
      {%- endcase -%}
    {%- endfor -%}
