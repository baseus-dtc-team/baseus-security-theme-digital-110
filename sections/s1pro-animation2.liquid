   <script>
   let screenWidth2 = window.screen.width
      var images2 = new Array();
      var totalImages2 = 100;
      var abc2 = 1;
      var funTip2 = 0;
  if(screenWidth2>750){
        for (var i = 1; i < totalImages2; i++) {
        var img2 = new Image();
        var slug2 = "000" + i;
        img2.src =
          "https://cdn.shopify.com/s/files/1/0555/8432/5709/files/dualview_0" + slug2.slice(-3) + ".webp";
        images2.push(img2);
      }
  }else{
       for (var i = 1; i < totalImages2; i++) {
        var img2 = new Image();
        var slug2 = "000" + i;
        img2.src =
          "https://cdn.shopify.com/s/files/1/0555/8432/5709/files/m_dualview_0" + slug2.slice(-3) + ".webp";
        images2.push(img2);
      }
  }
 
        //加载第一张图片
      setTimeout(() => {
          ctx2.fillRect(0, 0, c2.width, c2.height);
          ctx2.drawImage(images2[1], 0, 0, c2.width, c2.height);
      }, 200);
      // let head1 = document.querySelector('.announcement-bar').offsetHeight;
      // let head2 = document.querySelector('.header').offsetHeight;
      // let topslide = document.querySelector('.shopify-section--slideshow').offsetHeight;
      let tophelpcontact = document.querySelector('.shopify-s1pro-helpcontrast').offsetHeight;
      var showtime2 = document.getElementById("canvasbox2");
      var showfixed2 = document.getElementById("canvasfixed2");
      // var c2 = document.getElementById("background2");
      if(screenWidth2>750){var c2 = document.getElementById("background2");}else{var c2 = document.getElementById("background22");}
      var ctx2 = c2.getContext("2d");
      var protitle21 = document.getElementById("pro-box21");
      var protitle22 = document.getElementById("pro-box22");
      var protitle23 = document.getElementById("pro-box23");
      var protitle24 = document.getElementById("pro-box24");
      function swiper2(e) {
        funTip2 = 1;
        var scrollTop2 =
          (window.pageYOffset || document.documentElement.scrollTop) - head1 - head2 - topslide - topmulti - topreds - 2340 - tophelpcontact - 15
        if (parseInt(scrollTop2 / 13.5) < 1) {
          abc2 = 1;
        } else {
          abc2 = parseInt(scrollTop2 / 13.5);
        }
               // console.log(abc2,'abc2')  
        if (abc2 >= 5 && abc2 <= 30) {
          protitle21.style.display = "block";           
          protitle21.style.opacity = (abc2 - 10) / 5;
        } else if (abc2 >= 35 && abc2 <= 50) {
          protitle22.style.display = "block";
          protitle22.style.opacity = (abc2 - 35) / 5;
        }else if (abc2 >= 65 && abc2 <= 80) {
           protitle23.style.display = "block";
           protitle23.style.opacity = (abc2 - 65) / 5;     
        }else if (abc2 >= 85 && abc2 <= 99) {
          protitle24.style.display = "block";
          protitle24.style.opacity = (abc2 - 85) / 5;
        } else {
          protitle21.style.opacity = 0;
          protitle22.style.opacity = 0;
          protitle23.style.opacity = 0;
          protitle24.style.opacity = 0;
              protitle21.style.display = "none";
              protitle22.style.display = "none";
              protitle23.style.display = "none";
              protitle24.style.display = "none";          
        }
        if (abc2 <= 96) {
          ctx2.fillRect(0, 0, c2.width, c2.height);
          ctx2.drawImage(images2[abc2], 0, 0, c2.width, c2.height);
        }
       if (abc2 > 96) {
          ctx2.fillRect(0, 0, c2.width, c2.height);
          ctx2.drawImage(images2[97], 0, 0, c2.width, c2.height);
        }
         if(screenWidth2>750){var screenHeigt2 = 1080 - 945}else{var screenHeigt2 = 844 - 712}
        if (
          document.documentElement.scrollTop >=
          topslide + topmulti + topreds + 2340 + tophelpcontact - screenHeigt2 + 2340 + 10
        ) {
          showfixed2.style.position = "absolute";
          showfixed2.style.bottom = "0";
          showfixed2.style.top = "auto";
        } else {
          showfixed2.style.position = "fixed";
          showfixed2.style.top = "0";
          showfixed2.style.bottom = "auto";
        }
      }
   // var advanceShow2 = `-${c1.height - head1 - head2}px`
      var observer2 = new IntersectionObserver(
        (entries2) => {
          entries2.forEach((i2) => {
            // 通过滚动判断是否是当前的监听对象
            if (i2.isIntersecting) {
              showfixed2.style.position = "fixed";
              showfixed2.style.alignItems = "center";
              protitle3.style.display = "none";
              console.log("show2");
              window.onscroll = swiper2;
              return;
            } else {
              showfixed2.style.position = "unset";
              showfixed2.style.alignItems = "flex-start";
              protitle21.style.display = "none";
              protitle22.style.display = "none";
              console.log("disappear2");
              if (funTip2 > 0) {
                window.onscroll = undefined;
              }
              return;
            }
          });
        },
        {
         rootMargin: screenWidth > 1000 ? "0px 0px -945px 0px" : "0px 0px -712px 0px", // 提前150px进入可视区域时就加载图片，提高用户体验
           // rootMargin: "0px 0px " + advanceShow2 + " 0px"
        }
      );
      // observer2.observe(showtime2);
        function addEvent2(obj,type,fn){
    if(obj.attachEvent){ //ie
        obj.attachEvent('on'+type,function(){
            fn.call(obj);
        })
    }else{
        obj.addEventListener(type,fn,false);
    }
}
addEvent2(window,'scroll',function(){
          var scrollTopShow = (window.pageYOffset || document.documentElement.scrollTop)
      if(scrollTopShow >  topslide + topmulti + topreds + 2340 + tophelpcontact + 10 && scrollTopShow < topslide + topmulti + topreds + 2340 + tophelpcontact + 10 + 2340 + 10){
         observer2.observe(showtime2);
      }else{
        observer2.unobserve(showtime2);
        showfixed2.style.position = "unset";
      }
});
    </script>
