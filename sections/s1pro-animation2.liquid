  <style>
.animationbox2 {
  height: 2340px;
  position: relative;
  background-color: #000000;
  z-index: 3;
}
.animationfixed2 {
  position: absolute;
  top: 0;
  bottom: auto;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  height: 100%;
  width: 100%;
  z-index: 3;
}
.canvasbg2 {
  display:block;
  width: 100%;
  height: auto;
  max-height: 100%;
}
     .canvasbg22{
       display: none;
       width: 100%;
       max-height: 100%;
     }
.pro-title2 {
  position: fixed;
  z-index: 10;
  top: 55vh;
  left: 10vw;
  color: white;
  opacity: 0;
  width: 30vw
}
.animation_title2 {
  font-size: 1.3vw;
  color: yellow;
  padding-bottom: 5px;
  margin-bottom: 10px;
  border-bottom: 1px solid #ffffff;
}
.animation_content2 {
  font-size: 1vw;
  color: #ffffff;

}
   .animation_bottomgap2{
    height:5px;
    background-color: #000000;
    position: relative;
    z-index: 3;
  }
  .pro-title2-1{
    bottom: 50vh;
    left: 10vw;
    display: none;
  }
    .pro-title2-2{
     bottom: 30vh;
     right: 10vw;
     text-align: right;
    display: none;
  }
  .pro-title2-3{
     bottom: 50vh;
     right: 10vw;
    text-align: right;
    display: none;
  }
   .pro-title2-4{
     bottom: 30vh;
