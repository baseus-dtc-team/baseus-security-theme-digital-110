{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}
  <style>
    .breadcrumb {
      display:none;
    }
    .n1-sellpoints-content {
      display: flex;
      width: 100%;
      flex-wrap: wrap;
    }
    .n1-sellpoints-box {
      width: 33%;
      text-align: center;
      padding: 2% 0;
    }
    .n1-sellpoints-imgs {
      width: 100px;
    }
    .n1-sellpoints-text {
      font-size: 20px;
      margin: 20px 0;
    }
    @media screen and (max-width: 750px) {
      .n1-sellpoints-box {
        width: 50%;
      }
      .n1-sellpoints-imgs {
        width: 80px;
      }
      .n1-sellpoints-text {
        font-size: 18px;
        margin: 15px 0;
      }
    }
  </style>
<div class="rich-text {% if section.settings.full_width %}rich-text--full-width {% else %}container{% endif %} rich-text--align-{{ section.settings.alignment }} shopify-n1-sellpoints">
  <div class="rich-text__blocks {% if section.settings.full_width %}container{% endif %} color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'subheading' -%}
          <div
            class="rich-text__subheading subtitle"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.subheading | escape }}
          </div>
        {%- when 'heading' -%}
          <h2
            class="rich-text__heading title--section {% if block.settings.heading_size == 'medium' %}h2{% else %}h1{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.heading }}
          </h2>
        {%- when 'text' -%}
          <div class="rich-text__text" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </div>
        {%- when 'button' -%}
          <a
            {% if block.settings.button_link == blank %}
              aria-disabled="true"
            {% else %}
              href="{{ block.settings.button_link }}"
            {% endif %}
            class="button button--{{ block.settings.button_style }} focus-inset"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.button_label | escape }}
          </a>
      {%- endcase -%}
    {%- endfor -%}
    <div class="n1-sellpoints-content">
      <div class="n1-sellpoints-box">
        <img
          class="n1-sellpoints-imgs"
          src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_N1_Outdoor_Camera01.png?v=1743587057"
          alt=""
        />
        <div class="n1-sellpoints-text">210 Days of Battery Life</div>
      </div>
      <div class="n1-sellpoints-box">
        <img
          class="n1-sellpoints-imgs"
          src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_N1_Outdoor_Camera02.png?v=1743587057"
          alt=""
        />
        <div class="n1-sellpoints-text">Crisp 2K Visual Clarity</div>
      </div>
      <div class="n1-sellpoints-box">
        <img
          class="n1-sellpoints-imgs"
          src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_N1_Outdoor_Camera03.png?v=1743587057"
          alt=""
        />
        <div class="n1-sellpoints-text">145° Wider Field of View</div>
      </div>
      <div class="n1-sellpoints-box">
        <img
          class="n1-sellpoints-imgs"
          src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_N1_Outdoor_Camera04.png?v=1743587057"
          alt=""
        />
        <div class="n1-sellpoints-text">Smart NeuraNex Al Technology</div>
      </div>
      <div class="n1-sellpoints-box">
        <img
          class="n1-sellpoints-imgs"
          src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_N1_Outdoor_Camera05.png?v=1743650494"
          alt=""
        />
        <div class="n1-sellpoints-text">Local Storage, No Hidden Fees</div>
      </div>
      <div class="n1-sellpoints-box">
        <img
          class="n1-sellpoints-imgs"
          src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_N1_Outdoor_Camera06.png?v=1743587057"
          alt=""
        />
        <div class="n1-sellpoints-text">All-Season Durability</div>
      </div>
    </div>    
  </div>
</div>

{% schema %}
{
  "name": "n1-sellpoints",
  "tag": "section",
  "class": "spaced-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "t:sections.rich-text.settings.full_width.label"
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.rich-text.settings.alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.rich-text.settings.alignment.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "m",
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "m",
      "label": "t:sections.all.section-padding.padding_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "subheading",
      "name": "t:sections.rich-text.blocks.subheading.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "default": "Subheading",
          "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:sections.rich-text.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Heading for your section",
          "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "medium",
              "label": "t:sections.rich-text.blocks.heading.settings.heading_size.options__1.label"
            },
            {
              "value": "large",
              "label": "t:sections.rich-text.blocks.heading.settings.heading_size.options__2.label"
            }
          ],
          "default": "medium",
          "label": "t:sections.rich-text.blocks.heading.settings.heading_size.label"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.rich-text.blocks.text.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Description for your section.</p>",
          "label": "t:sections.rich-text.blocks.text.settings.text.label"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.rich-text.blocks.button.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "default": "Button label",
          "label": "t:sections.all.button.button_label.label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.all.button.button_link.label"
        },
        {
          "type": "select",
          "id": "button_style",
          "options": [
            {
              "value": "primary",
              "label": "t:sections.all.button.button_style.options__1.label"
            },
            {
              "value": "secondary",
              "label": "t:sections.all.button.button_style.options__2.label"
            },
            {
              "value": "tertiary",
              "label": "t:sections.all.button.button_style.options__3.label"
            }
          ],
          "default": "primary",
          "label": "t:sections.all.button.button_style.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "n1-sellpoints",
      "blocks": [
        {
          "type": "subheading"
        },
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
