{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}
  <style>
     .anchor{
       overflow: hidden;
     }
      .animationbox1 {
        height: 2000px;
        position: relative;
        background-color: #f6f6f6;
        z-index: 3;
      }
      .animationfixed1 {
        position: absolute;
        top: 0;
        bottom: auto;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        height: 100vh;
        width: 100%;
        z-index: 3;
      }
      .canvasbg1 {
        display:block;
        width: 100%;
        max-height: 100%;
        background: #f6f6f6;
        margin: auto;        
      }
     .canvasbg12{
       display: none;
       width: 100%;
       background: #f6f6f6;   
       max-height: 100%;
     }
      .pro-title11 {
   display:none;  
    position: fixed;
    z-index: 10;
    top: 35vh;
    left: 10%;
      }
        .pro-title12 {
       display:none;       
    position: fixed;
    z-index: 10;
    /* top: 20vh; */
    left: 10%;
    bottom: 10%;
      }
  .animation_title{
    font-size: 34px;
    font-weight: bold;
  }
  .animation_title span {
    color: #63A2FF;
    font-size: 54px;
    margin-right: 5px;
}    
  }
  .animation_content{
    font-size: 22px;
  }
   .animation_bottomgap1{
    height:5px;
    background-color: #ffffff;
    position: relative;     
    z-index: 3;
  }
  @media screen and (max-width: 750px) {
      .animationfixed1{
        align-items: center;
      }    
      .canvasbg1 {
        display: none;
      }
     .canvasbg12{
       display: block;
     }
    .pro-title11 {
        top: 100px;
        width: 100vw;
        padding: 0 20px;
        /* text-align: center; */
        left: 0;
    }
     .pro-title12 {
        display:none;
        top: 200px;
        width: 100vw;
        padding: 0 20px;
        text-align: center;
        left: 0;
      }
  .animation_title{
    font-size: 24px;
  }
  .animation_title span {
    font-size: 34px;
    margin-right: 3px;
}      
  .animation_content{
    font-size: 16px;
  }
  }
  </style>
    <div
      class="animationbox1"
      id="canvasbox1">
      <div
        class="pro-title11"
        id="pro-title11">
        <div class="animation_title"><span>16TB</span> Expandable Local Storage*</div>
        <!-- <div class="animation_content">Industry-leading sun-powered tracking system allows the solar panel to move 40° left and right with the sunlight.</div> -->
      </div>
       <div
        class="pro-title12"
        id="pro-title12">
        <!-- <div class="animation_title">Maximized Solar Power</div> -->
        <div class="animation_content">*16TB is the maximum expandable capacity. <br />
          Additional hard drive for storage expansion is not included.</div>
      </div>
      <div
        class="animationfixed1"
        id="canvasfixed1">
        <canvas
          class="canvasbg1"
          width="1920"
          height="1080"
          id="background1"></canvas>
        <canvas
          class="canvasbg12"
          width="750"
          height="1334"
          id="background12"></canvas>
      </div>
    </div>
   <script>
      let screenWidth = window.screen.width
      let head1 = document.querySelector('.announcement-bar').offsetHeight;
      let head2 = document.querySelector('.shopify-section-header').offsetHeight;
      let topslide = document.querySelector('.section-slideshow').offsetHeight;
      let topmulti = document.querySelector('.shopify-n1-sellpoints').offsetHeight;
      let topcompare = document.querySelector('.compare').offsetHeight;
      let topseewide = document.querySelector('.shopify-n1-seewide').offsetHeight;
      var showtime1 = document.getElementById("canvasbox1");
      var showfixed1 = document.getElementById("canvasfixed1");
      if(screenWidth>750){
        var c1 = document.getElementById("background1");
      }else{
        var c1 = document.getElementById("background12");
      }
      var ctx1 = c1.getContext("2d");
      var protitle11 = document.getElementById("pro-title11");
      var protitle12 = document.getElementById("pro-title12");
      var images1 = new Array();
      var abc1 = 1;
      var funTip1 = 0;
      if(screenWidth>750){
        var totalImages1 = 92;
      for (var i = 1; i < totalImages1; i++) {
        var img = new Image();
        var slug = "000" + i;
        img.src =
          "https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_N1_PC_16tb_" + slug.slice(-3) + ".jpg";
        images1.push(img);
      }
    }else{
      var totalImages1 = 92;
      for (var i = 1; i < totalImages1; i++) {
        var img = new Image();
        var slug = "000" + i;
        img.src =
          "https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_N1_MOB_16tb_" + slug.slice(-3) + ".jpg";
        images1.push(img);
      }
    }
      setTimeout(() => {
          ctx1.fillRect(0, 0, c1.width, c1.height);
          ctx1.drawImage(images1[1], 0, 0, c1.width, c1.height);
      }, 200);
      function swiper(e) {
        funTip1 = 1;
        var scrollTop =
          (window.pageYOffset || document.documentElement.scrollTop) - head1 - head2 - topslide - topmulti - topcompare - topseewide - 5
        if(screenWidth > 750){
          if (parseInt(scrollTop / 10) < 1) {
          abc1 = 1;
        } else {
          abc1 = parseInt(scrollTop / 10);
        }
        // if (abc1 >= 20 && abc1 <= 60) {
        //   protitle11.style.opacity = (abc1 - 20) / 10;
        // }else if (abc1 > 60 && abc1 < 70) {
        //   protitle11.style.opacity = 1 - (abc1 - 60) / 10;
        // }else if (abc1 > 80 && abc1 < 130) {
        //   protitle12.style.opacity = (abc1 - 80) / 10;
        // }else if (abc1 >= 130 && abc1 <= 140) {
        //   protitle12.style.opacity = 1 - (abc1 - 129) / 10;
        // } else {
        //   protitle11.style.opacity = 0;
        //   protitle12.style.opacity = 0;
        // }
        if (abc1 <= 90) {
          ctx1.fillRect(0, 0, c1.width, c1.height);
          ctx1.drawImage(images1[abc1], 0, 0, c1.width, c1.height);
              protitle11.style.display = "block"
              protitle12.style.display = "block"          
        } else {
               protitle11.style.display = "none"
              protitle12.style.display = "none"         
        }
        }else{
          if (parseInt(scrollTop / 10) < 1) {
          abc1 = 1;
        } else {
          abc1 = parseInt(scrollTop / 10);
        }
        // if (abc1 >= 20 && abc1 <= 50) {
        //   protitle11.style.opacity = (abc1 - 20) / 10;
        // }else if (abc1 > 50 && abc1 < 60) {
        //   protitle11.style.opacity = 1 - (abc1 - 50) / 10;
        // }else if (abc1 > 70 && abc1 < 100) {
        //   protitle12.style.opacity = (abc1 - 70) / 10;
        // }else if (abc1 >= 100 && abc1 <= 110) {
        //   protitle12.style.opacity = 1 - (abc1 - 100) / 10;
        // } else {
        //   protitle11.style.opacity = 0;
        //   protitle12.style.opacity = 0;
        // }
        if (abc1 <= 90) {
          ctx1.fillRect(0, 0, c1.width, c1.height);
          ctx1.drawImage(images1[abc1], 0, 0, c1.width, c1.height);
              protitle11.style.display = "block"
              // protitle12.style.display = "block"          
        } else {
               protitle11.style.display = "none"
              // protitle12.style.display = "none"         
        }
        }
        if(screenWidth>750){var screenHeigt = 1080 - 135}else{var screenHeigt = 844}
        if (
          document.documentElement.scrollTop >=
          topslide + topmulti + topcompare + topseewide + 2000 - screenHeigt + 5
        ) {
          showfixed1.style.position = "absolute";
          showfixed1.style.bottom = "0";
          showfixed1.style.top = "auto";
        } else {
          showfixed1.style.position = "fixed";
          showfixed1.style.top = "0";
          showfixed1.style.bottom = "auto";
        }
      }
      // var advanceShow1 = `-${c1.height - head1 - head2}px`
      var observer1 = new IntersectionObserver(
        (entries) => {
          entries.forEach((i) => {
            // 通过滚动判断是否是当前的监听对象
            if (i.isIntersecting) {
              showfixed1.style.position = "fixed";
              // protitle11.style.display = "block"
              // protitle12.style.display = "block"
              console.log("出现");
              window.onscroll = swiper;
              return;
            } else {
              showfixed1.style.position = "unset";
              protitle11.style.display = "none"
              protitle12.style.display = "none"
              console.log("消失");
              if (funTip1 > 0) {
                window.onscroll = undefined;
              }
              return;
            }
          });
        },
          {
          rootMargin: screenWidth > 1000 ? `0px 0px -1080px 0px` : "0px 0px -712px 0px", // 提前150px进入可视区域时就加载图片，提高用户体验
            // rootMargin: "0px 0px " + advanceShow1 + " 0px"
        }  
      );
      // observer1.observe(showtime1);
      function addEvent1(obj,type,fn){
    if(obj.attachEvent){ //ie
        obj.attachEvent('on'+type,function(){
            fn.call(obj);
        })
    }else{
        obj.addEventListener(type,fn,false);
    }
}
addEvent1(window,'scroll',function(){
          var scrollTopShow = (window.pageYOffset || document.documentElement.scrollTop)
      if(scrollTopShow <  topslide + topmulti + topcompare + topseewide + 2000 + 5){
         observer1.observe(showtime1);
      }else{
        observer1.unobserve(showtime1);
        showfixed1.style.position = "unset";
      }
});
      window.onbeforeunload = function () {
        //刷新后页面自动回到顶部
        document.documentElement.scrollTop = 0; //ie下
        document.body.scrollTop = 0; //非ie
      };
    </script>
