          "id": "text1",
          "default": "Engineered for Total Privacy",
          "label": "text1"
        }, 
        {
          "type": "text",
          "id": "text2",
          "default": "No cloud. No subscription. Full data control.",
          "label": "text2"
        }, 
        {
          "type": "text",
          "id": "text3",
