{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}
  <style>
    .n1-prodetail-allcontent {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .n1-prodetail-content {
      width: 100%;
      position: relative;
    }
    .n1-prodetail-titlebox {
      position: absolute;
      top: 50px;
      left: 40px;
      z-index: 2;
      width: 50%;
    }
    .n1-prodetail-title {
      font-weight: bold;
      font-size: 32px;
      margin-bottom: 10px;
    }
    .n1-prodetail-des {
      font-size: 18px;
    }
    .n1-prodetail-mainimg {
      width: 100%;
      border-radius: 20px;
    }
    .n1-prodetail-btntip {
      position: absolute;
      bottom: 30px;
      left: 40px;
      width: 50%;
    }
    .n1-prodetail-btnboxs {
      display: flex;
      gap: 20px;
    }
    .n1-prodetail-btnbox {
      text-align: center;
    }
    .n1-prodetail-btmdes {
      font-size: 16px;
    }
    .n1-prodetail-btnimg {
      width: 35px;
    }
    .n1-prodetail-color {
      color: #ffffff;
    }
    .n1-prodetail-videotip {
      top: 160px;
    }
    @media screen and (max-width: 750px) {
      .n1-prodetail-titlebox {
        position: unset;
        width: 100%;
        text-align: center;
        margin: 20px 0;
        color: #000000;
      }
      .n1-prodetail-title {
        font-size: 26px;
        margin-bottom: 5px;
      }
      .n1-prodetail-des {
        font-size: 16px;
      }
      .n1-prodetail-btntip {
        bottom: 30px;
        left: 20px;
        font-size: 12px;
      }
      .n1-prodetail-btmdes {
        font-size: 12px;
      }
      .n1-prodetail-videotip {
        top: auto;
        bottom: 20px;
      }
    }
  </style>
<div class="rich-text {% if section.settings.full_width %}rich-text--full-width {% else %}container{% endif %} rich-text--align-{{ section.settings.alignment }}">
  <div class="rich-text__blocks {% if section.settings.full_width %}container{% endif %} color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'subheading' -%}
          <div
            class="rich-text__subheading subtitle"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.subheading | escape }}
          </div>
        {%- when 'heading' -%}
          <h2
            class="rich-text__heading title--section {% if block.settings.heading_size == 'medium' %}h2{% else %}h1{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.heading }}
          </h2>
        {%- when 'text' -%}
          <div class="compare__description description body-large  description--center" {{ block.shopify_attributes }} style="margin: auto;">
            {{ block.settings.text }}
          </div>
        {%- when 'button' -%}
          <a
            {% if block.settings.button_link == blank %}
              aria-disabled="true"
            {% else %}
              href="{{ block.settings.button_link }}"
            {% endif %}
            class="button button--{{ block.settings.button_style }} focus-inset"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.button_label | escape }}
          </a>
      {%- endcase -%}
    {%- endfor -%}
      <div class="n1-prodetail-allcontent">
      <div class="n1-prodetail-content">
        <div class="n1-prodetail-titlebox">
          <div class="n1-prodetail-title">210-Day Battery Life</div>
          <div class="n1-prodetail-des">
            With a 7,800mAh battery, charge once a year for continuous home
            protection.
          </div>
        </div>
        <img
          class="n1-prodetail-mainimg"
          src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/05-210-Day.jpg?v=1743587101"
          alt=""
        />
        <div class="n1-prodetail-btntip">
          *Based on 10 seconds of video per recording, 30 recordings per
          daay.<br />
          *All data was provided by the Baseus Lab.
        </div>
      </div>
      <div class="n1-prodetail-content n1-prodetail-color">
        <div class="n1-prodetail-titlebox">
          <div class="n1-prodetail-title">Advanced Night Protection</div>
          <div class="n1-prodetail-des">
            Experience vivid details even in low light <br />
            with color night vision and spotlight.
          </div>
        </div>
        <img
          class="n1-prodetail-mainimg"
          src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_N1_Outdoor_Camera06.jpg?v=1743587106"
          alt=""
        />
        <div class="n1-prodetail-btntip">
          <div class="n1-prodetail-btnboxs">
            <div class="n1-prodetail-btnbox">
              <img
                class="n1-prodetail-btnimg"
                src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_N1_Outdoor_Camera_icon-02_2e332335-a048-4aba-88c1-11d50225a42a.png?v=1743587088"
                alt=""
              />
              <div class="n1-prodetail-btmdes">
                100LM <br />
                Spotlight
              </div>
            </div>
            <div class="n1-prodetail-btnbox">
              <img
                class="n1-prodetail-btnimg"
                src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_N1_Outdoor_Camera_icon-01_2178f000-1f48-4908-82d1-33c4ad29122e.png?v=1743587088"
                alt=""
              />
              <div class="n1-prodetail-btmdes">
                Smart Trigger <br />
                Reminder
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="n1-prodetail-content">
        <div class="n1-prodetail-titlebox">
          <div class="n1-prodetail-title">All-Season Durability</div>
          <div class="n1-prodetail-des">
            Built to last in any weather conditions from -20°C to 50°C.
          </div>
        </div>
        <video
          class="n1-prodetail-mainimg"
          muted
          autoplay="autoplay"
          loop="loop"
          src="https://cdn.shopify.com/videos/c/o/v/f33d6825c3604ad28781e12b9948b5dc.mp4"
        ></video>
        <div class="n1-prodetail-btntip n1-prodetail-videotip">
          <div class="n1-prodetail-btnboxs">
            <div class="n1-prodetail-btnbox">
              <img
                class="n1-prodetail-btnimg"
                src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_N1_Outdoor_Camera_icon-01.png?v=1743587080"
                alt=""
              />
              <div class="n1-prodetail-btmdes">sun</div>
            </div>
            <div class="n1-prodetail-btnbox">
              <img
                class="n1-prodetail-btnimg"
                src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_N1_Outdoor_Camera_icon-02.png?v=1743587081"
                alt=""
              />
              <div class="n1-prodetail-btmdes">Rain</div>
            </div>
            <div class="n1-prodetail-btnbox">
              <img
                class="n1-prodetail-btnimg"
                src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_N1_Outdoor_Camera_icon-03.png?v=1743587081"
                alt=""
              />
              <div class="n1-prodetail-btmdes">Sandstorm</div>
            </div>
            <div class="n1-prodetail-btnbox">
              <img
                class="n1-prodetail-btnimg"
                src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_N1_Outdoor_Camera_icon-04.png?v=1743587081"
                alt=""
              />
              <div class="n1-prodetail-btmdes">Snow</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

