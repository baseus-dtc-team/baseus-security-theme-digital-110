          alt=""
        />
      </div>
      <div class="s2-grid-sellpoints-boxs">
        <div class="s2-grid-sellpoints-title s2-grid-text1">
          Secure Local Storage
          <span
            >AES+RSA <br />
            Dual Encryption</span
          >
        </div>
        <img
          class="s2-grid-sellpoints-bgimgs"
          src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_S2_Outdoor_Camera_4K_05.jpg?v=1751877150"
