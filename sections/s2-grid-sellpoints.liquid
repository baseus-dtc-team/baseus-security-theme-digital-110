          </div>
          <img
            class="s2-grid-sellpoints-bgimgs"
            src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_S2_Outdoor_Camera_4K_06.jpg?v=1751858843"
