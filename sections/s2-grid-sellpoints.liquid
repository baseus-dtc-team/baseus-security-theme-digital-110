{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}
  <style>
    .breadcrumb {
      display: none;
    }
    .s2-grid-sellpoints-head {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin: 30px;
      text-align: center;
    }
    .s2-grid-sellpoints-headtitle {
      font-size: 34px;
      font-weight: bold;
      margin: 10px 0;
    }
    .s2-grid-sellpoints-subhead {
      font-size: 24px;
    }
    .s2-grid-sellpoints-content {
      display: flex;
      gap: 10px;
      width: 100%;
    }
    .s2-grid-sellpoints-zongbox {
      width: 50%;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .s2-grid-sellpoints-boxs {
      position: relative;
    }
    .s2-grid-sellpoints-title {
      position: absolute;
      width: 100%;
      text-align: center;
      font-size: 1.8vw;
      color: #000000;
      font-weight: bold;
    }
    .s2-grid-sellpoints-bgimgs {
      width: 100%;
      border-radius: 10px;
    }
    .s2-grid-text1 {
      top: 5%;
      font-size: 2vw;
      text-align: left;
      left: 5%;
      font-weight: bold;
      color: #000000;
    }
    .s2-grid-text1 span {
      display: block;
      font-size: 1.2vw;
      color: #555555;
    }
    .s2-grid-text2 {
      top: 5%;
      left: 5%;
      font-size: 2vw;
      width: 100%;
      text-align: left;
      font-weight: bold;
      color: #ffffff;
    }
    .s2-grid-text3 {
      width: max-content;
      top: 10%;
      left: 10%;
    }
    .s2-grid-text3-des {
      font-weight: bold;
    }
    .s2-grid-text4 {
      top: 7%;
    }
    .s2-grid-text4-des {
      font-weight: bold;
      font-size: 3.5vw;
    }
    .s2-grid-sellpoints-boxs2 {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .s2-grid-sellpoints-smallbox {
      width: calc(50% - 5px);
    }
    .s2-grid-centertext {
      font-size: 1.5vw;
    }
    .s2-grid-centertext span {
      font-size: 1.8vw;
      color: #ffffff;
    }
    .s2-grid-bottomtext {
      top: unset;
      bottom: 10%;
    }
    .zongbox1 {
      width: 35%;
    }
    .zongbox2 {
      width: 41.7%;
    }
    .zongbox3 {
      width: 23.2%;
    }
    .grid-pc-show {
      display: flex;
    }
    .grid-mo-show {
      display: none;
    }
    @media screen and (max-width: 750px) {
      .s2-grid-sellpoints-headtitle {
        font-size: 30px;
      }
      .s2-grid-sellpoints-subhead {
        font-size: 18px;
        width: 100%;
      }
      .s2-grid-centertext span {
        font-size: 30px;
      }
      .s2-grid-sellpoints-content {
        flex-direction: column;
        gap: 5px;
      }
      .s2-grid-sellpoints-zongbox {
        width: 100%;
      }
      .s2-grid-text1 {
        top: 10%;
        font-size: 20px;
      }
      .s2-grid-text1 span {
        font-size: 16px;
      }
      .s2-grid-text2 {
        top: 10%;
        font-size: 24px;
      }
      .s2-grid-sellpoints-title {
        font-size: 22px;
      }
      .s2-grid-text4-des {
        font-size: 34px;
      }
      .grid-pc-show {
        display: none;
      }
      .grid-mo-show {
        display: flex;
      }
    }
  </style>
<div class="rich-text {% if section.settings.full_width %}rich-text--full-width {% else %}container{% endif %} rich-text--align-{{ section.settings.alignment }}">
  <div class="rich-text__blocks {% if section.settings.full_width %}container{% endif %} color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'subheading' -%}
          <div
            class="rich-text__subheading subtitle"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.subheading | escape }}
          </div>
        {%- when 'heading' -%}
          <h2
            class="rich-text__heading title--section {% if block.settings.heading_size == 'medium' %}h2{% else %}h1{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.heading }}
          </h2>
        {%- when 'text' -%}
          <div class="compare__description description body-large  description--center" {{ block.shopify_attributes }} style="margin: auto;">
            {{ block.settings.text }}
          </div>
        {%- when 'button' -%}
          <a
            {% if block.settings.button_link == blank %}
              aria-disabled="true"
            {% else %}
              href="{{ block.settings.button_link }}"
            {% endif %}
            class="button button--{{ block.settings.button_style }} focus-inset"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.button_label | escape }}
          </a>
      {%- endcase -%}
    {%- endfor -%}
    <div class="s2-grid-sellpoints-content grid-pc-show">
      <div class="s2-grid-sellpoints-zongbox zongbox1">
        <div class="s2-grid-sellpoints-boxs">
          <div class="s2-grid-sellpoints-title s2-grid-text2">
            IP67 Weatherproof
          </div>
          <img
            class="s2-grid-sellpoints-bgimgs"
            src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_S2_Outdoor_Camera_4K_01-IP67.jpg?v=1751858844"
            alt=""
          />
        </div>
        <div class="s2-grid-sellpoints-boxs">
          <div class="s2-grid-sellpoints-title s2-grid-text1">
            Secure Local Storage
            <span>
              AES+RSA <br />
              Dual Encryption
            </span>
          </div>
          <img
            class="s2-grid-sellpoints-bgimgs"
            src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_S2_Outdoor_Camera_4K_04.jpg?v=1751858843"
            alt=""
          />
        </div>
      </div>
      <div class="s2-grid-sellpoints-zongbox zongbox2">
        <div class="s2-grid-sellpoints-boxs">
          <div class="s2-grid-sellpoints-title s2-grid-text2">Radar + PIR</div>
          <img
            class="s2-grid-sellpoints-bgimgs"
            src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_S2_Outdoor_Camera_4K_02.jpg?v=1751858844"
            alt=""
          />
        </div>
        <div class="s2-grid-sellpoints-boxs">
