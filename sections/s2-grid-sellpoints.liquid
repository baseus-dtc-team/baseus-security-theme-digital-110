            src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_S2_Outdoor_Camera_4K_05-4K.jpg?v=1751858843"
            alt=""
          />
        </div>
      </div>
      <div class="s2-grid-sellpoints-zongbox zongbox3">
        <div class="s2-grid-sellpoints-boxs">
          <div class="s2-grid-sellpoints-title s2-grid-text4">AI Detection</div>
          <img
            class="s2-grid-sellpoints-bgimgs"
            src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_S2_Outdoor_Camera_4K_03-AI.jpg?v=1751858843"
            alt=""
          />
        </div>
        <div class="s2-grid-sellpoints-boxs">
          <div class="s2-grid-sellpoints-title s2-grid-text4">
            Sun-Powerd <br />
