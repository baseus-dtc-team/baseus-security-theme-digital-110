{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}
  <style>

      body {
        margin: 0;
        padding: 0;
        height: auto;
        background-image: url('https://cdn.shopify.com/s/files/1/0895/4252/5298/files/MOB_01.jpg?v=1763626998');
        background-repeat: no-repeat;
        background-attachment: fixed;
        background-size: cover;        
        position: relative;
      }

      .snowflake {
        position: absolute;
        top: -10px;
        background: white;
        border-radius: 50%;
        opacity: 0.8;
        animation: fall linear infinite;
        z-index: 200;
      }

      @keyframes fall {
        to {
          transform: translateY(300vh);
          opacity: 0;
        }
      }
body {
  position: relative;
  background: #d2d2d2;
  background-image: url('https://cdn.shopify.com/s/files/1/0895/4252/5298/files/MOB_01.jpg?v=1763626998');
}
body:after {
  content: '';
  display: block;
  position: absolute;
  z-index: 2;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  background-image: url('https://cdn.shopify.com/s/files/1/0770/7151/5968/files/snow1_snow_effect.webp?v=1734515647'), url('https://cdn.shopify.com/s/files/1/0770/7151/5968/files/snow2_snow_effect.webp?v=1734515666'), url('https://cdn.shopify.com/s/files/1/0770/7151/5968/files/snow3_snow_effect.webp?v=1734515655');
  animation: snow 10s linear infinite;
}
@keyframes snow {
  0% {
    background-position: 0px 0px, 0px 0px, 0px 0px;
  }
  50% {
    background-position: 500px 500px, 100px 200px, -100px 150px;
  }
  100% {
    background-position: 500px 1000px, 200px 400px, -100px 300px;
  }
}      
  </style>
 <div class="rich-text {% if section.settings.full_width %}rich-text--full-width {% else %}container{% endif %} rich-text--align-{{ section.settings.alignment }}">
  <div class="rich-text__blocks {% if section.settings.full_width %}container{% endif %} color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">   
 
    </div>    
      </div>
          {% comment %} <script>
      // 创建雪花
      function createSnow() {
        const snowContainer = document.body;

        // 创建50个雪花
        for (let i = 0; i < 100; i++) {
          const snowflake = document.createElement("div");
          snowflake.classList.add("snowflake");

          // 随机大小 (2px 到 8px)
          const size = Math.random() * 6 + 2;
          snowflake.style.width = size + "px";
          snowflake.style.height = size + "px";

          // 随机位置
          snowflake.style.left = Math.random() * 400 + "vw";

          // 随机下落速度 (5s 到 15s)
          const duration = Math.random() * 10 + 5;
          snowflake.style.animationDuration = duration + "s";

          // 随机延迟开始
          snowflake.style.animationDelay = Math.random() * 5 + "s";

          snowContainer.appendChild(snowflake);
        }
      }

      // 页面加载后创建雪花
      window.onload = createSnow;
    </script> {% endcomment %}
