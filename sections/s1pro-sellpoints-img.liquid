{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}
  <style>
    .s1pro-prodetail-allcontent {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .s1pro-prodetail-content {
      width: 100%;
      position: relative;
    }
    .s1pro-prodetail-titlebox {
      position: absolute;
      top: 30%;
      left: 6%;
      z-index: 2;
      width: 50%;
      text-align: left;
    }
    .s1pro-prodetail-title {
      font-weight: bold;
      font-size: 32px;
      margin-bottom: 10px;
    }
    .s1pro-prodetail-des {
      font-size: 18px;
    }
    .s1pro-prodetail-mainimg {
      width: 100%;
      border-radius: 20px;
    }
    .s1pro-prodetail-btntip {
      position: absolute;
      bottom: 30px;
      left: 6%;
      width: 50%;
      text-align: left;
    }
    .s1pro-prodetail-btnboxs {
      display: flex;
      gap: 20px;
    }
    .s1pro-prodetail-btnbox {
      text-align: center;
    }
    .s1pro-prodetail-btmdes {
      font-size: 16px;
    }
    .s1pro-prodetail-btnimg {
      width: 35px;
    }
    .s1pro-prodetail-color {
      color: #ffffff;
    }
    .s1pro-prodetail-videotip {
      top: 160px;
    }
    @media screen and (max-width: 750px) {
      .s1pro-prodetail-titlebox {
        position: unset;
        width: 100%;
        text-align: center;
        margin: 20px 0;
        color: #000000;
      }
      .s1pro-prodetail-title {
        font-size: 26px;
        margin-bottom: 5px;
      }
      .s1pro-prodetail-des {
        font-size: 16px;
      }
      .s1pro-prodetail-btntip {
        display: none;
        bottom: 30px;
        left: 20px;
        font-size: 12px;
      }
      .s1pro-prodetail-btmdes {
        font-size: 12px;
      }
      .s1pro-prodetail-videotip {
        top: auto;
        bottom: 20px;
      }
    }
  </style>
<div class="rich-text {% if section.settings.full_width %}rich-text--full-width {% else %}container{% endif %} rich-text--align-{{ section.settings.alignment }}">
  <div class="rich-text__blocks {% if section.settings.full_width %}container{% endif %} color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'subheading' -%}
          <div
            class="rich-text__subheading subtitle"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.subheading | escape }}
          </div>
        {%- when 'heading' -%}
          <h2
            class="rich-text__heading title--section {% if block.settings.heading_size == 'medium' %}h2{% else %}h1{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.heading }}
          </h2>
        {%- when 'text' -%}
          <div class="rich-text__text" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </div>
        {%- when 'button' -%}
          <a
            {% if block.settings.button_link == blank %}
              aria-disabled="true"
            {% else %}
              href="{{ block.settings.button_link }}"
            {% endif %}
            class="button button--{{ block.settings.button_style }} focus-inset"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.button_label | escape }}
          </a>
      {%- endcase -%}
    {%- endfor -%}
    <div class="s1pro-prodetail-allcontent">
      <div class="s1pro-prodetail-content">
        <div class="s1pro-prodetail-titlebox">
          <div class="s1pro-prodetail-title">No Hidden Fees</div>
          <div class="s1pro-prodetail-des">
            Safely secure your data on local storage with no monthly
            subscription fees.
          </div>
        </div>
        <img
          class="s1pro-prodetail-mainimg"
          src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_S1_Pro_Outdoor_Camera01-0_-PC.jpg?v=1744600092"
          alt=""
        />
        <div class="s1pro-prodetail-btntip">
          *Based on 10 seconds of video per recording, 30 recordings peday<br />
          *All data was provided by the Baseus Lab.
        </div>
      </div>
      <div class="s1pro-prodetail-content s1pro-prodetail-color">
        <div class="s1pro-prodetail-titlebox">
          <div class="s1pro-prodetail-title">
            Data Security with Local Storage
          </div>
          <div class="s1pro-prodetail-des">
            Baseus S1 Pro has a 16GB built-in eMMC <br />
            storage that can save videos up to 3 months <br />
            without worrying about leaks.
          </div>
        </div>
        <img
          class="s1pro-prodetail-mainimg"
          src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_S1_Pro_Outdoor_Camera02-_16GB-PC.jpg?v=1744600094"
          alt=""
        />
      </div>
      <div class="s1pro-prodetail-content s1pro-prodetail-color">
        <div class="s1pro-prodetail-titlebox">
          <div class="s1pro-prodetail-title">Max. 16TB Expandable Storage*</div>
          <div class="s1pro-prodetail-des">
            *16TB is the maximum expandable capacity. <br />
            Additional hard drive for storage expansion is not included
          </div>
        </div>
        <img
          class="s1pro-prodetail-mainimg"
          src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_S1_Pro_Outdoor_Camera03-_16TB-PC.jpg?v=1744600093"
          alt=""
        />
      </div>
      <div class="s1pro-prodetail-content">
        <div class="s1pro-prodetail-titlebox">
          <div class="s1pro-prodetail-title">Your Privacy Matters to Us</div>
          <div class="s1pro-prodetail-des">
            At Baseus Security, we are fully committed <br />
            and dedicated to securing your home <br />
            safety as well as your privacy. With our <br />
            TÜV Certified military-grade encryption <br />
            technology, your personal data remains privateand<br />
            onlyaccessibletoyou.You. You <br />
            have the total control over your privacy, no <br />
            need to worry about data leaks anymore.
          </div>
        </div>
        <img
          class="s1pro-prodetail-mainimg"
          src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_S1_Pro_Outdoor_Camera04-_-PC.jpg?v=1744600094"
          alt=""
        />
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "s1pro-sellpoints-img",
  "tag": "section",
  "class": "spaced-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "t:sections.rich-text.settings.full_width.label"
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.rich-text.settings.alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.rich-text.settings.alignment.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "m",
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "m",
      "label": "t:sections.all.section-padding.padding_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "subheading",
      "name": "t:sections.rich-text.blocks.subheading.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "default": "Subheading",
          "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:sections.rich-text.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Heading for your section",
          "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "medium",
              "label": "t:sections.rich-text.blocks.heading.settings.heading_size.options__1.label"
            },
            {
              "value": "large",
              "label": "t:sections.rich-text.blocks.heading.settings.heading_size.options__2.label"
            }
          ],
          "default": "medium",
          "label": "t:sections.rich-text.blocks.heading.settings.heading_size.label"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.rich-text.blocks.text.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Description for your section.</p>",
          "label": "t:sections.rich-text.blocks.text.settings.text.label"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.rich-text.blocks.button.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "default": "Button label",
          "label": "t:sections.all.button.button_label.label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.all.button.button_link.label"
        },
        {
          "type": "select",
          "id": "button_style",
          "options": [
            {
              "value": "primary",
              "label": "t:sections.all.button.button_style.options__1.label"
            },
            {
              "value": "secondary",
              "label": "t:sections.all.button.button_style.options__2.label"
            },
            {
              "value": "tertiary",
              "label": "t:sections.all.button.button_style.options__3.label"
            }
          ],
          "default": "primary",
          "label": "t:sections.all.button.button_style.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "s1pro-sellpoints-img",
      "blocks": [
        {
          "type": "subheading"
        },
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
