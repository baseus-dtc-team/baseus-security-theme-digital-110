{{ 'section-popular-products.css' | asset_url | stylesheet_tag }}
{{ 'component-badge.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- if settings.quickview_show or settings.add_to_cart_enabled -%}
  <link
    rel="preload"
    href="{{ 'section-main-product.css' | asset_url }}"
    as="style"
    onload="this.onload=null;this.rel='stylesheet'"
  >
  <link rel="stylesheet" href="{{ 'component-deferred-media.css' | asset_url }}" media="all">
  <link
    rel="preload"
    href="{{ 'quick-add.css' | asset_url }}"
    as="style"
    onload="this.onload=null;this.rel='stylesheet'"
  >

  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if settings.quickview_show == false and settings.type_color_swatch == 'custom' -%}
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}
  <style>
    #shopify-section-{{ section.id }}{
    {% comment %} @media screen and (max-width: 750px) {
     .card-information {
       height: 100%;
     }
     .card-information__wrapper {
       height: 50%;
     }
    } {% endcomment %}
    @media screen and (max-width: 575px) {
      .popular-products--2-mobile .collection-product-card .card-information {
        padding: 1rem;
      }
    .popular-products__wrapper {
      gap: 1rem;
    }      
    }    
    }
  </style>
<style>
#shopify-section-{{ section.id }}{
      .tabs-container {
        {% comment %} max-width: 800px; {% endcomment %}
        margin: 0 auto;
        background: white;
        border-radius: 12px;
        {% comment %} box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08); {% endcomment %}
        overflow: hidden;
        text-align: center;    
      }

      /* Tab标题样式 */
      .tabs {
        display: flex;
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
      }

      .tab {
        flex: 1;
        padding: 18px 40px;
        text-align: center;
        cursor: pointer;
        color: #000000;
        font-size: 16px;
        font-weight: 500;
        transition: all 0.3s ease;
        position: relative;
        border-radius: 90px;
        line-height: 57px;
        margin: 0 10px;
      }

      .tab:hover {
        color: #ffffff;
        background: #000000;
      }

      /* 隐藏radio按钮 */
      .tab-input {
        display: none;
      }

      /* 激活状态 */
      .tab-input:checked + .tab {
        color: #000000;
        background: #f7f8f8;
      }

      {% comment %} .tab-input:checked + .tab::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: #ffd166;
      } {% endcomment %}

      /* Tab内容区域 */
      .tab-content {
        display: none;
        padding: 32px 24px;
        animation: fadeIn 0.5s ease;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* 显示对应的内容 */
      #tab1:checked ~ .tab-content-1,
      #tab2:checked ~ .tab-content-2,
      #tab3:checked ~ .tab-content-3,
      #tab4:checked ~ .tab-content-4 {
        display: flex;
      }

      .tab-content h3 {
        margin-bottom: 12px;
        color: #2d3748;
        font-size: 20px;
      }
      .card-information .price-item--sale {
        font-size: 20px;
      }
      .card-information .price__regular {
        font-size: 20px;
      }
      .tab-content p {
        color: #4a5568;
        line-height: 1.6;
        margin-bottom: 16px;
      }

      .tab-content ul {
        {% comment %} padding-left: 20px; {% endcomment %}
        color: #4a5568;
        line-height: 1.6;
      }

      .tab-content li {
        margin-bottom: 8px;
        text-align: left;
      }
      .card--product .card__add-to-cart {
         display: none;
      } 
      .card--product .quick-add {
         display: none;
      }
      @media screen and (min-width: 1400px){
      .tab-content {
        max-width: 80%;
        margin: auto;
      }
      }      
      @media screen and (max-width: 750px) {
      .tab-content h3 {
        margin-bottom: 6px;
        font-size: 16px;
      }
      .card-information .price-item--sale {
        font-size: 16px;
      }
      .card-information .price__regular {
        font-size: 16px;
      }      
      }    
}
</style>

<section class="trait-content">
    <div class="tabs-container">
      <!-- Tab选择器 -->
      {%- for block in section.blocks -%}
      <input type="radio" name="tabs" id="tab{{ forloop.index }}" class="tab-input" checked />
      <label for="tab{{ forloop.index }}" class="tab">{{ block.settings.tab_text }}</label>
      {%- endfor -%}
      <!-- Tab内容 -->
      {%- for block in section.blocks -%}
      <div class="tab-content tab-content-{{ forloop.index }}">
      <ul
        class="
          popular-products__wrapper content
          popular-products__wrapper--{{ block.settings.products_to_show }}
          popular-products--{{ section.settings.columns_mobile }}-mobile
          list-unstyled
        "
      >
        {%- for product in block.settings.product_list -%}
        {%- if product.available != false -%}
          <li
            class="
              popular-products__item collection-product-card
              quickview{%- if settings.quickview_hover -%}--hover{% endif %}
            "
          >
            {% render 'deals-product-card',
              product_card_product: product,
              media_ratio: section.settings.image_ratio,
              media_fit: section.settings.image_fit,
              show_secondary_image: section.settings.show_secondary_image,
              show_vendor: section.settings.show_vendor,
              show_desc: section.settings.show_desc,
              section_id: section.id,
              add_id: forloop.index,
              color_scheme: section.settings.color_scheme
            %}
          </li>
        {% endif %}
        {%- endfor -%}
      </ul>
      </div>
      {%- endfor -%}
      {% comment %} <div class="tab-content tab-content-2">
        <h3>我们的产品</h3>
        <p>我们提供一系列创新的解决方案，助力您的业务发展。</p>
        <ul>
          <li>企业级软件解决方案</li>
          <li>移动应用开发</li>
          <li>云服务平台</li>
          <li>数据分析工具</li>
        </ul>
      </div>

      <div class="tab-content tab-content-3">
        <h3>服务与支持</h3>
        <p>我们提供7x24小时专业技术支持，确保您的系统稳定运行。</p>
        <ul>
          <li>专业的技术支持团队</li>
          <li>在线文档和教程</li>
          <li>定期更新和维护</li>
          <li>定制化培训服务</li>
        </ul>
      </div>

      <div class="tab-content tab-content-4">
        <h3>联系我们</h3>
        <p>欢迎随时与我们取得联系，我们将尽快回复您。</p>
        <ul>
          <li>邮箱：contact@example.com</li>
          <li>电话：+86 400-123-4567</li>
          <li>地址：上海市浦东新区科技园区</li>
          <li>工作时间：周一至周五 9:00-18:00</li>
        </ul>
      </div> {% endcomment %}
    </div>  
</section>

{% schema %}
{
  "name": "product-collection-list",
  "class": "shopify-section--product-collection-list",
  "blocks": [
    {
      "type": "item",
      "name": "item",
      "limit": 6,
      "settings": [
    {
      "type": "product_list",
      "id": "product_list",
      "label": "product_list"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.popular-products.settings.products_to_show.label"
    },
    {
      "type": "text",
      "id": "tab_text",
      "label": "tab_text"
    },    
      ]
    }
  ],
  "settings": [
    {
      "type": "color",
      "id": "bgColor",
      "label": "Background",
      "default": "#fff"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "1",
      "label": "t:sections.main-collection-product-grid.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__2.label"
        }
      ]
    },    
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "1/1",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__1.label"
        },
        {
          "value": "3/2",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__2.label"
        },
        {
          "value": "4/5",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__3.label"
        },
        {
          "value": "5/4",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__4.label"
        }
      ],
      "default": "5/4",
      "label": "t:sections.main-collection-product-grid.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "t:sections.all.card.image_fit.label",
      "options": [
        {
          "value": "contain",
          "label": "t:sections.all.card.image_fit.options__1.label"
        },
        {
          "value": "cover",
          "label": "t:sections.all.card.image_fit.options__2.label"
        }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "t:sections.all.card.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.all.card.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_desc",
      "default": false,
      "label": "t:sections.all.card.show_desc.label",
      "info": "t:sections.all.card.show_desc.info"
    }, 
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },       
  ],
  "presets": [
    {
      "name": "product-collection-list",
      "blocks": [
        {
          "type": "item",
          "settings": {
         
          }
        }
      ]
    }
  ]
}
{% endschema %}
