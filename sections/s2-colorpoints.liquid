{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}
  <style>
    .s2-color-contant {
      display: flex;
    }
    .s2-color-textbox {
      width: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .s2-color-textboxs {
      display: flex;
      flex-direction: column;
      gap: 10px;
      text-align: left;
    }
    .s2-color-title {
      font-size: 30px;
      font-weight: bold;
    }
    .s2-color-des {
      font-size: 18px;
    }
    .s2-color-iconcontent {
      display: flex;
      gap: 20px;
      margin-top: 20px;
    }
    .s2-color-iconbox {
      text-align: center;
    }
    .s2-color-iconimg {
      height: 35px;
    }
    .s2-color-iconimg-two {
      height: 80px;
    }
    .s2-color-icontext {
      font-size: 16px;
    }
    .s2-color-bgimgbox {
      width: 50%;
    }
    .s2-color-bgimg {
      width: 100%;
      border-radius: 20px;
    }
    .s2-colorpoints-content {
      padding: 0;
      margin: 0;
      max-width: none;      
    }

    @media screen and (max-width: 750px) {
      .s2-color-contant {
        flex-direction: column;
      }
      .s2-color-textbox {
        width: 100%;
        margin: 20px 0;
      }
      .s2-color-textboxs {
        align-items: center;
        text-align: center;
      }
      .s2-color-title {
        font-size: 24px;
      }
      .s2-color-des {
        font-size: 16px;
      }
      .s2-color-iconimg {
        height: 25px;
      }
      .s2-color-iconimg-two {
        height: 65px;
      }      
      .s2-color-bgimgbox {
        width: 100%;
      }
      .s2-color-iconcontent {
        margin-top: 10px;
      }
      .s2-color-turn {
        display: flex;
        flex-direction: column-reverse;
      }
    }
  </style>
<div class="rich-text {% if section.settings.full_width %}rich-text--full-width {% else %}container{% endif %} rich-text--align-{{ section.settings.alignment }}">
  <div class="rich-text__blocks {% if section.settings.full_width %}container{% endif %} color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding s2-colorpoints-content">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'subheading' -%}
          <div
            class="rich-text__subheading subtitle"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.subheading | escape }}
          </div>
        {%- when 'heading' -%}
          <h2
            class="rich-text__heading title--section {% if block.settings.heading_size == 'medium' %}h2{% else %}h1{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.heading }}
          </h2>
        {%- when 'text' -%}
          <div class="rich-text__text" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </div>
        {%- when 'button' -%}
          <a
            {% if block.settings.button_link == blank %}
              aria-disabled="true"
            {% else %}
              href="{{ block.settings.button_link }}"
            {% endif %}
            class="button button--{{ block.settings.button_style }} focus-inset"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.button_label | escape }}
          </a>
      {%- endcase -%}
    {%- endfor -%}
    <div class="s2-color-contant s2-color-turn">
      <div class="s2-color-bgimgbox">
        <img
          class="s2-color-bgimg"
          src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_S2_Outdoor_Camera_4K_01_56aeee1f-f0f4-40ac-92c3-bac9bb91fe74.jpg?v=1751956108"
          alt=""
        />
      </div>      
      <div class="s2-color-textbox">
        <div class="s2-color-textboxs">
          <div class="s2-color-title">
            See Clearer Even at Night
          </div>
          <div class="s2-color-des">
            Identify faces,license plates,and motion <br />
            clearly in both color and black-and-white, <br />
            providing reliable visibility after dark.
          </div>
          <div class="s2-color-iconcontent">
            <div class="s2-color-iconbox">
              <img
                class="s2-color-iconimg"
                src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_S2_Outdoor_Camera_4K_icon_a3d51377-4c33-469a-bafe-2421dc33cf85.png?v=1751956107"
                alt=""
              />
              <div class="s2-color-icontext">
                100LM Spotlight
              </div>
            </div>
              <div class="s2-color-iconbox">
                <img
                  class="s2-color-iconimg"
                  src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_S2_Outdoor_Camera_4K_icon_be0423f4-336b-4600-b4dd-321f91491f82.png?v=1751956108"
                  alt=""
                />
                <div class="s2-color-icontext">
                  More Light, Sharper Details
                </div>
              </div>
          </div>
        </div>
      </div>
    </div>
    <div class="s2-color-contant">
      <div class="s2-color-textbox">
        <div class="s2-color-textboxs">
          <div class="s2-color-title">
            No More Battery Anxiety
          </div>
          <div class="s2-color-des">
            Built-in 7800mAh battery + endless solar charging keep <br />
            your camera powered around the clock. No more manual <br />
            charging required!
          </div>
          <div class="s2-color-iconcontent">
            <div class="s2-color-iconbox">
              <img
                class="s2-color-iconimg"
                src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_S2_Outdoor_Camera_4K_13500mAh.png?v=1751956114"
                alt=""
              />

            </div>
              <div class="s2-color-iconbox">
                <img
                  class="s2-color-iconimg"
                  src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_S2_Outdoor_Camera_4K_30min.png?v=1751956114"
                  alt=""
                />
              </div>
          </div>
        </div>
      </div>
      <div class="s2-color-bgimgbox">
        <img
          class="s2-color-bgimg"
          src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_S2_Outdoor_Camera_4K_02_1fd4114b-1e33-46af-9052-6eb23130a451.jpg?v=1751956114"
          alt=""
        />
      </div>
    </div>    
    <div class="s2-color-contant s2-color-turn">
      <div class="s2-color-bgimgbox">
        <img
          class="s2-color-bgimg"
          src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/Baseus_Security_S2_Outdoor_Camera_4K_03IP67.jpg?v=1751956119"
          alt=""
        />
      </div>      
      <div class="s2-color-textbox">
        <div class="s2-color-textboxs">
          <div class="s2-color-title">
            IP67 Durability for All Seasons
          </div>
          <div class="s2-color-des">
            No yellowing. No curling. No deformation.
          </div>
          <div class="s2-color-iconcontent">
            <div class="s2-color-iconbox">
              <img
                class="s2-color-iconimg s2-color-iconimg-two"
                src="https://cdn.shopify.com/s/files/1/0895/4252/5298/files/img_v3_02o0_cd855133-f288-44cb-aeb2-46d040478a9g.png?v=1751961557"
                alt=""
              />
            </div>
          </div>
        </div>
      </div>
    </div>    
  </div>
</div>

{% schema %}
{
  "name": "s2-colorpoints",
  "tag": "section",
  "class": "spaced-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "t:sections.rich-text.settings.full_width.label"
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.rich-text.settings.alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.rich-text.settings.alignment.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "m",
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "m",
      "label": "t:sections.all.section-padding.padding_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "subheading",
      "name": "t:sections.rich-text.blocks.subheading.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "default": "Subheading",
          "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:sections.rich-text.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Heading for your section",
          "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "medium",
              "label": "t:sections.rich-text.blocks.heading.settings.heading_size.options__1.label"
            },
            {
              "value": "large",
              "label": "t:sections.rich-text.blocks.heading.settings.heading_size.options__2.label"
            }
          ],
          "default": "medium",
          "label": "t:sections.rich-text.blocks.heading.settings.heading_size.label"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.rich-text.blocks.text.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Description for your section.</p>",
          "label": "t:sections.rich-text.blocks.text.settings.text.label"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.rich-text.blocks.button.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "default": "Button label",
          "label": "t:sections.all.button.button_label.label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.all.button.button_link.label"
        },
        {
          "type": "select",
          "id": "button_style",
          "options": [
            {
              "value": "primary",
              "label": "t:sections.all.button.button_style.options__1.label"
            },
            {
              "value": "secondary",
              "label": "t:sections.all.button.button_style.options__2.label"
            },
            {
              "value": "tertiary",
              "label": "t:sections.all.button.button_style.options__3.label"
            }
          ],
          "default": "primary",
          "label": "t:sections.all.button.button_style.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "s2-colorpoints",
      "blocks": [
        {
          "type": "subheading"
        },
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
