{% doc %}
  @prompt
    生成一个带tag menu的section，然后每个tag对应的板块有标题、内容，内容为富文本，可以链接动态源
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-tab-menu-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-tab-menu-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-tab-menu-nav-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.tab_gap }}px;
    border-bottom: 2px solid {{ block.settings.border_color }};
    margin-bottom: {{ block.settings.content_spacing }}px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .ai-tab-menu-nav-{{ ai_gen_id }}::-webkit-scrollbar {
    height: 4px;
  }

  .ai-tab-menu-nav-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
    background: {{ block.settings.border_color }};
    border-radius: 2px;
  }

  .ai-tab-menu-button-{{ ai_gen_id }} {
    background: none;
    border: none;
    padding: {{ block.settings.tab_padding_vertical }}px {{ block.settings.tab_padding_horizontal }}px;
    font-size: {{ block.settings.tab_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.tab_inactive_color }};
    cursor: pointer;
    position: relative;
    white-space: nowrap;
    transition: color 0.3s ease;
    border-bottom: 3px solid transparent;
    margin-bottom: -2px;
  }

  .ai-tab-menu-button-{{ ai_gen_id }}:hover {
    color: {{ block.settings.tab_hover_color }};
  }

  .ai-tab-menu-button-{{ ai_gen_id }}.active {
    color: {{ block.settings.tab_active_color }};
    border-bottom-color: {{ block.settings.tab_active_border_color }};
  }

  .ai-tab-menu-content-{{ ai_gen_id }} {
    display: none;
    animation: ai-tab-fade-in-{{ ai_gen_id }} 0.3s ease-in-out;
  }

  .ai-tab-menu-content-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-tab-menu-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin-bottom: {{ block.settings.title_spacing }}px;
    line-height: 1.3;
  }

  .ai-tab-menu-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_font_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  .ai-tab-menu-text-{{ ai_gen_id }} p {
    margin-bottom: 1em;
  }

  .ai-tab-menu-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-tab-menu-text-{{ ai_gen_id }} h1,
  .ai-tab-menu-text-{{ ai_gen_id }} h2,
  .ai-tab-menu-text-{{ ai_gen_id }} h3,
  .ai-tab-menu-text-{{ ai_gen_id }} h4,
  .ai-tab-menu-text-{{ ai_gen_id }} h5,
  .ai-tab-menu-text-{{ ai_gen_id }} h6 {
    margin-top: 1.5em;
    margin-bottom: 0.5em;
    font-weight: 600;
  }

  .ai-tab-menu-text-{{ ai_gen_id }} ul,
  .ai-tab-menu-text-{{ ai_gen_id }} ol {
    margin-bottom: 1em;
    padding-left: 1.5em;
  }

  .ai-tab-menu-text-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-tab-menu-text-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  @keyframes ai-tab-fade-in-{{ ai_gen_id }} {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-tab-menu-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-tab-menu-nav-{{ ai_gen_id }} {
      gap: {{ block.settings.tab_gap | times: 0.7 }}px;
    }

    .ai-tab-menu-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.tab_font_size | times: 0.9 }}px;
      padding: {{ block.settings.tab_padding_vertical | times: 0.8 }}px {{ block.settings.tab_padding_horizontal | times: 0.8 }}px;
    }

    .ai-tab-menu-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.85 }}px;
    }

    .ai-tab-menu-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<tab-menu-{{ ai_gen_id }} class="ai-tab-menu-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-tab-menu-container-{{ ai_gen_id }}">
    <nav class="ai-tab-menu-nav-{{ ai_gen_id }}" role="tablist">
      {% for i in (1..5) %}
        {% liquid
          assign tab_enabled_key = 'tab_' | append: i | append: '_enabled'
          assign tab_label_key = 'tab_' | append: i | append: '_label'
          assign tab_enabled = block.settings[tab_enabled_key]
          assign tab_label = block.settings[tab_label_key]
        %}
        
        {% if tab_enabled and tab_label != blank %}
          <button
            class="ai-tab-menu-button-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
            data-tab="tab-{{ i }}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="content-{{ i }}-{{ ai_gen_id }}"
          >
            {{ tab_label }}
          </button>
        {% endif %}
      {% endfor %}
    </nav>

    <div class="ai-tab-menu-contents-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign tab_enabled_key = 'tab_' | append: i | append: '_enabled'
          assign tab_title_key = 'tab_' | append: i | append: '_title'
          assign tab_content_key = 'tab_' | append: i | append: '_content'
          assign tab_enabled = block.settings[tab_enabled_key]
          assign tab_title = block.settings[tab_title_key]
          assign tab_content = block.settings[tab_content_key]
        %}
        
        {% if tab_enabled %}
          <div
            class="ai-tab-menu-content-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
            data-content="tab-{{ i }}"
            role="tabpanel"
            id="content-{{ i }}-{{ ai_gen_id }}"
          >
            {% if tab_title != blank %}
              <h2 class="ai-tab-menu-title-{{ ai_gen_id }}">{{ tab_title }}</h2>
            {% endif %}
            
            {% if tab_content != blank %}
              <div class="ai-tab-menu-text-{{ ai_gen_id }}">
                {{ tab_content }}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</tab-menu-{{ ai_gen_id }}>

<script>
  (function() {
    class TabMenu{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.buttons = this.querySelectorAll('.ai-tab-menu-button-{{ ai_gen_id }}');
        this.contents = this.querySelectorAll('.ai-tab-menu-content-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.buttons.forEach((button) => {
          button.addEventListener('click', () => {
            const tabId = button.getAttribute('data-tab');
            this.switchTab(tabId, button);
          });
        });
      }

      switchTab(tabId, clickedButton) {
        this.buttons.forEach((btn) => {
          btn.classList.remove('active');
          btn.setAttribute('aria-selected', 'false');
        });

        this.contents.forEach((content) => {
          content.classList.remove('active');
        });

        clickedButton.classList.add('active');
        clickedButton.setAttribute('aria-selected', 'true');

        const targetContent = this.querySelector(`[data-content="${tabId}"]`);
        if (targetContent) {
          targetContent.classList.add('active');
        }
      }
    }

    customElements.define('tab-menu-{{ ai_gen_id }}', TabMenu{{ ai_gen_id }});
  })();
</script>

