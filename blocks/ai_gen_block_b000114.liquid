{% doc %}
  @prompt
    生成一个可以新增图片和注释的section，一排四个，移动端一排两个，右上角有个问号按钮，触碰点击，则注释的文字就显现，注释文字在图片上面，都可以配置
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: auto;
  }

  .ai-image-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-image-grid__item-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-image-grid__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    {% comment %} overflow: hidden; {% endcomment %}
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-image-grid__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-grid__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-grid__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-image-grid__help-button-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.button_offset }}px;
    right: {{ block.settings.button_offset }}px;
    width: {{ block.settings.button_size }}px;
    height: {{ block.settings.button_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ block.settings.button_size | times: 0.6 }}px;
    font-weight: bold;
    z-index: 2;
    transition: transform 0.2s ease;
  }

  .ai-image-grid__help-button-{{ ai_gen_id }}:hover {
    transform: scale(1.1);
  }

  .ai-image-grid__annotation-{{ ai_gen_id }} {
    position: absolute;
    top: 40px;
    left: 0;
    right: 0;
    background-color: {{ block.settings.annotation_bg_color }};
    color: {{ block.settings.annotation_text_color }};
    padding: {{ block.settings.annotation_padding }}px;
    border-radius: {{ block.settings.image_border_radius }}px {{ block.settings.image_border_radius }}px 0 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    z-index: 1;
    font-size: {{ block.settings.annotation_font_size }}px;
    line-height: 1.4;
    width: 96%;
    margin: auto;
    border-radius: 6px;
  }

  .ai-image-grid__annotation-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  @media screen and (max-width: 749px) {
    .ai-image-grid__container-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  .ai-image-grid-{{ ai_gen_id }} {
      width: calc(100% - 20px);
  }    
  }
{% endstyle %}

<image-grid-{{ ai_gen_id }}
  class="ai-image-grid-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-image-grid__container-{{ ai_gen_id }}">
    {% for i in (1..8) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign annotation_key = 'annotation_' | append: i
        assign image = block.settings[image_key]
        assign annotation = block.settings[annotation_key]
      %}
      {% if image %}
      <div class="ai-image-grid__item-{{ ai_gen_id }}" data-item-id="{{ i }}">
        <div class="ai-image-grid__image-wrapper-{{ ai_gen_id }}">
          {% if image %}
            <img
              src="{{ image | image_url: width: 600 }}"
              alt="{{ image.alt | escape }}"
              class="ai-image-grid__image-{{ ai_gen_id }}"
              loading="lazy"
              width="600"
              height="600"
            >
          {% endif %}

          {% if annotation != blank %}
            <div class="ai-image-grid__annotation-{{ ai_gen_id }}" data-annotation="{{ i }}">
              {{ annotation }}
            </div>
          {% endif %}

          {% if annotation != blank %}
            <button
              class="ai-image-grid__help-button-{{ ai_gen_id }}"
              aria-label="显示注释"
              data-help-button="{{ i }}"
            >
              ?
            </button>
          {% endif %}
        </div>
      </div>
     {% endif %} 
    {% endfor %}
  </div>
</image-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.helpButtons = this.querySelectorAll('.ai-image-grid__help-button-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.helpButtons.forEach((button) => {
          const itemId = button.getAttribute('data-help-button');
          const annotation = this.querySelector(`.ai-image-grid__annotation-{{ ai_gen_id }}[data-annotation="${itemId}"]`);

          button.addEventListener('click', () => {
            this.querySelectorAll('.ai-image-grid__annotation-{{ ai_gen_id }}').forEach((ann) => {
              if (ann !== annotation) {
                ann.classList.remove('active');
              }
            });

            annotation.classList.toggle('active');
          });
        });

        document.addEventListener('click', (event) => {
          if (
            !event.target.closest('.ai-image-grid__help-button-{{ ai_gen_id }}') &&
            !event.target.closest('.ai-image-grid__annotation-{{ ai_gen_id }}')
          ) {
            this.querySelectorAll('.ai-image-grid__annotation-{{ ai_gen_id }}').forEach((ann) => {
              ann.classList.remove('active');
            });
          }
        });
      }
    }

    customElements.define('image-grid-{{ ai_gen_id }}', ImageGrid{{ ai_gen_id }});
  })();
</script>

