    .timerbg {
      background-color: black;
      color: #FFF100;
      border-radius: 6px;
      font-size: 20px;
     line-height: 28px;
      padding: 0 5px;
    }
  .heard-tle {
    font-size: 24px;
  }
  #countrybuttons {
    display: none;
  }
  }  
</style>
