           if (path.indexOf('en-uk') > -1) {
                  countryText.textContent = 'United Kingdom';
                  countryFlag.src = 'https://cdn.shopify.com/s/files/1/0555/8432/5709/files/United-kingdom_flag_icon_round.png?v=1724828199';
