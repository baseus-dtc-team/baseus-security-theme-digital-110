  <script>
       function getQueryString(name) {
        let reg = new RegExp('(^|&)' + name + '=([^&]*)(&|$)', 'i')
        let r = window.location.search.substr(1).match(reg)
        if (r != null) {
          return decodeURIComponent(r[2])
        }
        return null
      }
      let paths = getQueryString('irclickid')
      let fileAddress = window.location.pathname
      let urltopLink = window.location.href.indexOf("en-eu") > 0 || window.location.href.indexOf("en-uk") > 0
      let urlHost = "https://security.baseus.com"
          function toUs() {
            if(urltopLink == true){
            if(paths){
               location.href = urlHost + fileAddress.slice(6) + "?irclickid=" + paths;
            }else{
               location.href = urlHost + fileAddress.slice(6)  ;
            }              
            }else{
            if(paths){
               location.href = urlHost + fileAddress + "?irclickid=" + paths;
            }else{
               location.href = urlHost + fileAddress ;
            }              
            }
         
      }
          function toEu() {
            if(urltopLink == true){
            if(paths){
               location.href = urlHost + '/en-eu' +  fileAddress.slice(6)  + "?irclickid=" + paths;
            }else{
               location.href = urlHost + '/en-eu' +  fileAddress.slice(6);
            }                
            }else{
            if(paths){
               location.href = urlHost + '/en-eu' + fileAddress + "?irclickid=" + paths;
            }else{
               location.href = urlHost + '/en-eu' + fileAddress ;
            }             
            }
         
      }    
          function toUk() {
            if(urltopLink == true){
            if(paths){
               location.href = urlHost + '/en-uk' + fileAddress.slice(6)+ "?irclickid=" + paths;
            }else{
               location.href = urlHost + '/en-uk' + fileAddress.slice(6);
            }                
            }else{
            if(paths){
               location.href = urlHost + '/en-uk' + fileAddress + "?irclickid=" + paths;
            }else{
               location.href = urlHost + '/en-uk' + fileAddress;
            }             
            }
         
      }        
      var countrybuttons = document.getElementById("countrybuttons");
      var countrymodal = document.getElementById("countrymodal");
      countrybuttons.onclick = function() {
        countrymodal.style.display = "block";
      };
      document.getElementById("countryclose").onclick = function() {
        countrymodal.style.display = "none";
      };
