{% comment %}
		Renders a product card
		Accepts:
		- product_card_product: {Object} Product Liquid object (optional)
		- show_secondary_image: {Boolean} Show the secondary image on hover. Default: false (optional)
		- show_vendor: {Boolean} Show the product vendor. Default: true
		- show_desc: {Boolean} Show the product vendor. Default: false
		- section_id: {String} The ID of the section that contains this card.
		Usage:
	{% render 'product-card', show_vendor: section.settings.show_vendor %}
{% endcomment %}

{% liquid
  assign aspect_ratio = media_ratio | split: '/'
  assign temp = aspect_ratio[0] | append: '.0'
  assign padding_bottom = aspect_ratio[1] | divided_by: temp | times: 100 | round: 2

  assign lowest_price_variant = blank
  for variant in product_card_product.variants
    if variant.available
      if lowest_price_variant == blank or variant.price < lowest_price_variant.price
        assign lowest_price_variant = variant
      endif
    endif
  endfor

  if lowest_price_variant == blank
    assign lowest_price_variant = product_card_product.variants | sort: 'price' | first
  endif
%}

{%- if settings.quickview_show or settings.add_to_cart_enabled -%}
	{%- assign first_3d_model = product_card_product.media | where: "media_type", "model" | first -%}
	{%- if first_3d_model -%}
		{{ 'component-product-model.css' | asset_url | stylesheet_tag }}
		<link id="ModelViewerStyle" rel="stylesheet" href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css" media="print" onload="this.media='all'">
		<link id="ModelViewerOverride" rel="stylesheet" href="{{ 'component-model-viewer-ui.css' | asset_url }}" media="print" onload="this.media='all'">
	{%- endif -%}

	{%- if first_3d_model -%}
		<script type="application/json" id="ProductJSON-{{ product.id }}">
		{{ product_card_product.media | where: 'media_type', 'model' | json }}

		</script>

		<script src="{{ 'product-model.js' | asset_url }}" defer></script>
	{%- endif -%}
{%- endif -%}
  <style>
	.card-information {
	  padding: 2.4rem;
	  display: flex;
	  flex: 1 1 auto;
	}

    .card-information .price__regular {
      font-size: 24px;
    }

    .card-information .price-item--sale {
      font-size: 24px;
    }

    .card__link {
      opacity: 1;
      position: unset;
    }

    .card-wrapper .button--link {
	  display: block !important;
      width: max-content !important;
      transform: none;
      margin-top: 15px; 
      position: relative;
      z-index: 10;
      left: 0;
	  bottom: 0;
	  padding: 0 20px;
    }

    .popular-products__item .card-wrapper {
      height: 100%;
      display: flex;
      flex-direction: column;
    }

	.card-information__wrapper {
	  min-height: 190px;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
	}

    .card-information__group-left {
      display: grid;
      grid-template-rows: 96px minmax(112px, auto);
      row-gap: 8px;
      align-content: start;
    }

    .card-information__group-left .card__title {
      height: 96px;
      margin: 0;
      display: flex;
      align-items: flex-start;
      overflow: hidden;
    }

    .product-included-devices {
      min-height: 112px;
      height: auto;
      margin-top: 0;
      align-self: start;
      overflow: visible;
    }

    .card-purchase-area {
      width: 100%;
      margin: auto 0 0 0 !important;
      padding: 12px 0 0 0 !important;
      text-align: left !important;
      align-self: stretch !important;
    }

    .price--card {
      min-height: 34px;
      width: 100% !important;
      display: flex !important;
      flex-direction: row !important;
      align-items: baseline !important;
      justify-content: flex-start !important;
      align-self: flex-start !important;
      text-align: left !important;
      margin: 0 0 14px 0 !important;
      padding: 0 !important;
      transform: none !important;
    }

    .price--card .price__sale,
    .price--card .price__regular {
      width: auto !important;
      display: flex !important;
      flex-direction: row !important;
      align-items: baseline !important;
      justify-content: flex-start !important;
      align-self: flex-start !important;
      text-align: left !important;
      gap: 8px;
      flex-wrap: wrap;
      margin: 0 !important;
      padding: 0 !important;
      transform: none !important;
    }

    .price--card .price__sale .price-item,
    .price--card .price__regular .price-item {
      margin-left: 0 !important;
      margin-right: 0 !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
    }

    .price--card .price__sale .price-item--regular {
      order: 2;
      color: #717178;
      font-size: 16px;
    }

    .price--card .price__sale .price-item--sale {
      order: 1;
      margin-left: 0 !important;
    }

    .card-actions {
      min-height: 46px;
      display: flex;
      align-items: stretch;
      gap: 10px;
    }

    .card-actions__buy {
      display: flex;
      align-items: stretch;
    }

    .card-actions__buy .card__add-to-cart,
    .card-actions__buy .quick-add,
    .card-actions__buy modal-opener {
      display: flex;
      align-items: stretch;
    }

    .card-actions .card__link,
    .card-actions .card__learn-more {
      min-height: 44px;
      margin-top: 0 !important;
      padding: 0 20px;
      display: inline-flex !important;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      white-space: nowrap;
      position: relative;
      z-index: 10;
      box-sizing: border-box;
      border-radius: var(--border-radius-button, 4px);
    }

    .card-actions .card__learn-more {
      font-weight: 600;
    }

    .card-wrapper .icon-cart {
      display: none;
    }

	.card-wrapper .icon-eye {
	  display: none;
	}

    .card-wrapper .card__information-top {
      position: absolute !important;
      top: 12px !important;
      left: 12px !important;
      right: auto !important;
      bottom: auto !important;
      width: auto !important;
      max-width: calc(100% - 24px);
      margin: 0 !important;
      padding: 0 !important;
      z-index: 5;
    }

    .card-wrapper .card__badge {
      width: auto !important;
      display: flex !important;
      justify-content: flex-start !important;
      align-items: flex-start !important;
      text-align: left !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .card-wrapper .card__badge .badge {
      margin: 0 !important;
    }

	.product-included-devices {
      color: #717178;
      line-height: 1.3;
    }

    .product-included-devices__preview {
      height: calc(1.3em * 3);
      overflow: hidden;
    }

    .product-included-devices > div:first-child {
      height: 1.3em;
      line-height: 1.3;
      margin: 0 0 2px 0;
    }

    .product-included-devices__preview .metafield-rich_text_field {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
      overflow: hidden;
      line-height: 1.3;
      max-height: calc(1.3em * 3);
    }

    .product-included-devices .metafield-rich_text_field ul {
      padding-left: 20px;
      line-height: 1.3;
      color: #717178;
      margin: 0;
      list-style-type: disc;
    }

    .product-included-devices .metafield-rich_text_field p {
      margin: 0;
    }

    .product-included-devices__details {
      margin-top: 4px;
      position: relative;
      z-index: 30;
      pointer-events: auto;
    }

    .product-included-devices__details > summary {
      width: max-content;
      cursor: pointer;
      list-style: none;
      color: inherit;
      font-size: 13px;
      line-height: 1.2;
      user-select: none;
      position: relative;
      z-index: 31;
      pointer-events: auto;
    }

    .product-included-devices__details > summary::-webkit-details-marker {
      display: none;
    }

    .product-included-devices__label--less {
      display: none;
    }

    .product-included-devices__details[open] .product-included-devices__label--more {
      display: none;
    }

    .product-included-devices__details[open] .product-included-devices__label--less {
      display: inline;
    }

    .product-included-devices__arrow {
      display: inline-block;
      margin-left: 3px;
      transition: transform 0.2s ease;
    }

    .product-included-devices__details[open] .product-included-devices__arrow {
      transform: rotate(180deg);
    }

    .product-included-devices:has(.product-included-devices__details[open]) .product-included-devices__preview {
      display: none;
    }

    .product-included-devices__details[open] {
      position: relative;
      z-index: 20;
      background: inherit;
      height: auto;
      overflow: visible;
    }

    .product-included-devices:has(.product-included-devices__details[open]) {
      min-height: 112px;
      height: auto;
    }

    .product-included-devices__details-content {
      margin-top: 6px;
      position: static;
      height: auto;
      overflow: visible;
      padding-bottom: 8px;
    }

	@media screen and (max-width: 750px) {
      .card-information__wrapper{
	    min-height: unset;
	  }

	  .popular-products--2-mobile .collection-product-card .button--link {
	    padding: 0 14px;
	  }

      .card-actions {
        gap: 8px;
      }

      .card-actions .card__link,
      .card-actions .card__learn-more {
        padding: 0 12px;
        min-height: 42px;
        font-size: 13px;
      }

	  .card-information .price-item--sale {
	    font-size: 18px;
	  }

      .card-information .price__regular {
        font-size: 18px;
      }

      .price--card .price__sale .price-item--regular {
        font-size: 14px;
      }
	}
  </style>
<div class="card-wrapper js-color-swatches-wrapper {% if color_scheme %} color-{{ color_scheme }} {% else %} color-{{ settings.card_color_scheme }} {% endif %}"
	data-product = "{{ product_card_product.handle }}"
>
	<span class="visually-hidden">{{ product_card_product.title | escape }}</span>

	<div class="card card--product" tabindex="-1">
		<div class="card__inner full-unstyled-link">
			{%- liquid
				assign featured_media_aspect_ratio = product_card_product.featured_media.aspect_ratio

				if product_card_product.featured_media.aspect_ratio == null
					assign featured_media_aspect_ratio = 1
				endif
			-%}

			<div
				class="media media--transparent media--hover-effect"
				style="padding-bottom: {{ padding_bottom }}%;">
				{%- if product_card_product.featured_media -%}
					{% liquid
					assign aspect_ratio_settings =  aspect_ratio[1] | divided_by: temp 
					assign aspect_ratio_img_width = product_card_product.featured_media.height | plus: 0.0 | divided_by: product_card_product.featured_media.width | round: 2
					assign aspect_ratio_img_height = product_card_product.featured_media.width | plus: 0.0 | divided_by: product_card_product.featured_media.height | round: 2
					
					assign width_ratio = 1
					if aspect_ratio_settings < 1
						if aspect_ratio_settings < aspect_ratio_img_width and aspect_ratio_img_width > 1
							assign width_ratio = aspect_ratio_img_width 
						elsif aspect_ratio_settings < aspect_ratio_img_width and aspect_ratio_img_width < 1
							assign width_ratio = aspect_ratio_img_height 
						elsif aspect_ratio_settings > aspect_ratio_img_width and aspect_ratio_img_width < 1
							assign width_ratio = aspect_ratio_img_height
						else
						endif
					else
						if aspect_ratio_settings < aspect_ratio_img_width and aspect_ratio_img_width > 1
							assign width_ratio = aspect_ratio_img_width
						elsif aspect_ratio_settings > aspect_ratio_img_width and aspect_ratio_img_width > 1
							assign width_ratio = aspect_ratio_settings
						elsif aspect_ratio_settings > aspect_ratio_img_width and aspect_ratio_img_width < 1
							assign width_ratio = aspect_ratio_img_height | times: aspect_ratio_settings | round: 2 | plus: aspect_ratio_img_width
						else 
							assign width_ratio = aspect_ratio_settings | plus: 0.25
						endif
					endif
					%}

					{% if columns %}
						{% capture sizes %}
							{% if columns == 5 %}
								(min-width: 1600px) calc(((100vw - 40px) / 5) * {{ width_ratio }}),
							{% endif %}
							{% if columns >= 4 %}
								(min-width: 1360px) calc(((100vw - 40px) / 4) * {{ width_ratio }}),
							{% endif %}
							{% if columns >= 3 %}
								(min-width: 990px) calc(((100vw - 40px) / 3) * {{ width_ratio }}),
							{% endif %}
							(min-width: 576px) calc(((100vw - 40px) / 2) * {{ width_ratio }}),
							calc(((100vw - 40px)) * {{ width_ratio }})
						{% endcapture %}
					{% else %}
						{% capture sizes %}
							(min-width: 1100px) calc(535px * {{ width_ratio }}), (min-width: 750px) calc(((100vw - 130px) / 2) * {{ width_ratio }}), calc(((100vw - 50px) / 2) * {{ width_ratio }})
						{% endcapture %}
					{% endif %}
					
					{% capture style %}
						{%- if media_fit == 'contain' -%}
							object-fit: contain;
						{%- endif -%}
						{%- if media_fit == 'cover' -%}
							object-fit: cover;
						{%- endif -%}
					{% endcapture %}

					{{ product_card_product.featured_media | image_url: width: product_card_product.featured_media.width | image_tag:
            	loading: 'lazy',
							class: "motion-reduce media--first",
            	widths: '360, 535, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600',
							sizes: sizes,
							style: style
          }}

					{%- if product_card_product.media[1] != null
						and show_secondary_image
					-%}
						{{ product_card_product.media[1] | image_url: width: product_card_product.media[1].width | image_tag:
							loading: 'lazy',
							class: "motion-reduce media--second",
							widths: '360, 533, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600',
							sizes: sizes,
							style: style
						}}
					{%- endif -%}
				{%- else -%}
					{{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
				{%- endif -%}
			</div>
			<div class="card__information-top">
				{%- if settings.badge_sale_show or settings.badge_soldout_show or settings.badge_custom_show -%}
					<div class="card__badge bold body-small">
						{%- if product_card_product.available == false and settings.badge_soldout_show -%}
							<span
								class="badge badge--soldout color-{{ settings.badge_soldout_color_scheme }}"
								aria-hidden="true"
							>
								{% if settings.soldout_icon != 'none' %}
									<span class="icon--{{- settings.soldout_icon_style }} icon--{{- settings.soldout_icon_fill_type }}">
										<i class="icon icon-pack icon-{{ settings.soldout_icon }} {% if settings.soldout_icon_style == 'colored' and settings.soldout_icon_fill_type == 'gradient' %} text-gradient {% endif %}"></i>
									</span>
								{% endif %}
								{{- 'products.product.sold_out' | t -}}
							</span>
						{%- elsif lowest_price_variant.compare_at_price
								> lowest_price_variant.price
							and product_card_product.available and settings.badge_sale_show
						-%}
							<span class="badge badge--sale color-{{ settings.badge_sale_color_scheme }}" aria-hidden="true">
								{% if settings.sale_icon != 'none' %}
									<span class="icon--{{- settings.sale_icon_style }} icon--{{- settings.sale_icon_fill_type }}">
										<i class="icon icon-pack icon-{{ settings.sale_icon }} {% if settings.sale_icon_style == 'colored' and settings.sale_icon_fill_type == 'gradient' %} text-gradient {% endif %}"></i>
									</span>
								{% endif %}
								{% if settings.badge_sale_type == "sale" %}
									{{- 'products.product.on_sale' | t -}}
								{% else %}
									{{- 'products.product.on_sale' | t -}}
									<span>
										{{ lowest_price_variant.compare_at_price 
											| minus: lowest_price_variant.price 
											| times: 100 
											| divided_by: lowest_price_variant.compare_at_price }}%
									</span>
								{% endif %}
							</span>
						{%- endif -%}
						{% if settings.badge_custom_show and product_card_product.metafields.custom.badges != blank %}
							{% if product_card_product.metafields.custom.badges.list? %}
								{% for badge in product_card_product.metafields.custom.badges.value %}
									<span class="badge badge--custom color-{{ settings.badge_custom_color_scheme }}" aria-hidden="true">
										{% if settings.custom_icon != 'none' %}
											<span class="icon--{{- settings.custom_icon_style }} icon--{{- settings.custom_icon_fill_type }}">
												<i class="icon icon-pack icon-{{ settings.custom_icon }} {% if settings.custom_icon_style == 'colored' and settings.custom_icon_fill_type == 'gradient' %} text-gradient {% endif %}"></i>
											</span>
										{% endif %}
										{{ badge }}
									</span>
								{% endfor %}
							{% else %}
								<span class="badge badge--custom color-{{ settings.badge_custom_color_scheme }}" aria-hidden="true">
									{% if settings.custom_icon != 'none' %}
										<span class="icon--{{- settings.custom_icon_style }} icon--{{- settings.custom_icon_fill_type }}">
											<i class="icon icon-pack icon-{{ settings.custom_icon }} {% if settings.custom_icon_style == 'colored' and settings.custom_icon_fill_type == 'gradient' %} text-gradient {% endif %}"></i>
										</span>
									{% endif %}
									{{ product_card_product.metafields.custom.badges }}
								</span>
							{% endif %}
						{% endif %}
					</div>
				{%- endif -%}
			</div>
		</div>
        <div style="opacity: 0;">
		{%- if settings.add_to_cart_enabled and product_card_product.selected_or_first_available_variant.available and product_card_product.has_only_default_variant or product_card_product.options.size == 1 and settings.type_color_swatch == 'custom' and  product_card_product.options[0] == settings.trigger_swatch -%}
			{%- assign product_form_id = 'quick-add-'
				| append: section_id
				| append: product_card_product.id
			-%}
			<product-form class="card__add-to-cart card__button">
				{%- form 'product',
					product_card_product,
					id: product_form_id,
					class: 'form',
					novalidate: 'novalidate',
					data-type: 'add-to-cart-form'
				-%}
					<input
						type="hidden"
						name="id"
						value="{{ product_card_product.selected_or_first_available_variant.id }}"
						disabled
					>
					<button
						id="{{ product_form_id }}-submit"
						type="submit"
						class="card__link button 
							button--{{ settings.quickview_button_style }} 
							card__link--{{ settings.quickview_button_layout }}
							{% if settings.show_on_mobile -%}card__link--show{%- endif %}
							card-focused"
						name="add"
						aria-haspopup="dialog"
						aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ product_card_product.id }}"
						aria-live="polite"
						data-sold-out-message="true"
						{% if product_card_product.selected_or_first_available_variant.available == false %}
							disabled
						{% endif %}
						aria-label="{{- 'general.card.quick__add' | t -}}"
					>
						{% if settings.quickview_button_style == 'link' %}
							{% render 'icon-cart' %}
						{% else %}
							<span class="card__quickview-text"> 
								{{- 'general.card.quick__add' | t -}}
							</span>
						{% endif %}
						<span class="sold-out-message hidden">
							{{ 'products.product.sold_out' | t }}
						</span>
						<div class="loading-overlay__spinner hidden">
							<svg
								aria-hidden="true"
								focusable="false"
								role="presentation"
								class="spinner"
								viewBox="0 0 66 66"
								xmlns="http://www.w3.org/2000/svg"
							>
								<circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
							</svg>
						</div>
                     Add to Cart   
					</button>
				{%- endform -%}
			</product-form>
		{%- elsif settings.quickview_show -%}
			<div class="quick-add no-js-hidden">
				{%- assign product_form_id = 'quick-add-'
					| append: section_id
					| append: product_card_product.id
				-%}
				<modal-opener data-modal="#QuickAdd-{{ product_card_product.id }}">
					<button
						id="{{ product_form_id }}-submit"
						type="submit"
						name="add"
						class="card__link button 
							button--{{ settings.quickview_button_style }} card__link--{{ settings.quickview_button_layout }}
							{%- if settings.show_on_mobile -%}card__link--show{%- endif %}
							card-focused"
						aria-haspopup="dialog"
						aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ product_card_product.id }}"
						data-product-url="{{ product_card_product.url }}"
					>
						{% if settings.quickview_button_style == 'link' %}
							{% render 'icon-eye' %}
						{% else %}
							<span class="card__quickview-text">
								{{- 'general.card.quick__view' | t -}}
							</span>
						{% endif %}
						<div class="loading-overlay__spinner hidden">
							<svg
								aria-hidden="true"
								focusable="false"
								role="presentation"
								class="spinner"
								viewBox="0 0 66 66"
								xmlns="http://www.w3.org/2000/svg"
							>
								<circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
							</svg>
						</div>
                        Buy Now
					</button>
				</modal-opener>
				<quick-add-modal
					id="QuickAdd-{{ product_card_product.id }}"
					class="quick-add-modal"
				>
					<div
						role="dialog"
						aria-label="{{ 'products.product.choose_product_options' | t: product_name: product_card_product.title | escape }}"
						aria-modal="true"
						class="quick-add-modal__content global-settings-popup"
					>
						<button
							id="ModalClose-{{ product_card_product.id }}"
							type="button"
							class="quick-add-modal__toggle modal-close-button"
							aria-label="{{ 'accessibility.close' | t }}"
							tabindex="-1"
						>
							{% render 'icon-close' %}
						</button>
						<div class="quick-add-modal__content-wrapper">
							<div
								id="QuickAddInfo-{{ product_card_product.id }}"
								class="quick-add-modal__content-info"
							></div>
						</div>
					</div>
				</quick-add-modal>
			</div>
		{%- endif -%}   
        </div>     
	</div>

	<div class="card-information">
		<div class="card-information__wrapper">
			<div class="card-information__group">
				<div class="card-information__group-left">
					{%- if show_vendor -%}
						<span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
						<div class="card__vendor body-small {% if settings.enable_vendor_link %} card__vendor_link {% endif %}">
							{% if settings.enable_vendor_link %}
								{{ product_card_product.vendor | link_to_vendor: class: "focus-inset" }}
							{% else %}
								{{ product_card_product.vendor }}
							{% endif %}
						</div>
					{%- endif -%}
					<h3 class="card__title h5">
						<a
							class="full-unstyled-link"
							href="{{ product_card_product.url | default: '#' }}"
						>
							{{- product_card_product.title | escape -}}
						</a>
					</h3>
					{%- if product_card_product.metafields.custom.included_devices != blank -%}
					<div class="product-included-devices">
						<div>Included Devices:</div>
						<div class="product-included-devices__preview">
							{{ product_card_product.metafields.custom.included_devices | metafield_tag }}
						</div>
						<details class="product-included-devices__details">
							<summary>
								<span class="product-included-devices__label product-included-devices__label--more">View More</span><span class="product-included-devices__label product-included-devices__label--less">View Less</span><span class="product-included-devices__arrow">⌄</span>
							</summary>
							<div class="product-included-devices__details-content">
								{{ product_card_product.metafields.custom.included_devices | metafield_tag }}
							</div>
						</details>
					</div>
					{% endif %} 
				</div>
				{%- if settings.add_to_cart_enabled and settings.quickview_show == false -%}
					{%- if product_card_product.selected_or_first_available_variant.available == false %}
						<a href="{{ product_card_product.url }}" class="card__more button button--simple button--arrow">
							<span>{{ settings.more_label }}</span>
							{% render 'icon-button-arrow' %}
						</a>
					{% else %}
						{% if product_card_product.options.size > 1 %}
							<a href="{{ product_card_product.url }}" class="card__more button button--simple button--arrow">
								<span>{{ settings.more_label }}</span>
								{% render 'icon-button-arrow' %}
							</a>
						{% elsif product_card_product.has_only_default_variant == false and product_card_product.options.size == 1 and product_card_product.options[0] != settings.trigger_swatch %}
							<a href="{{ product_card_product.url }}" class="card__more button button--simple button--arrow">
								<span>{{ settings.more_label }}</span>
								{% render 'icon-button-arrow' %}
							</a>
						{% elsif product_card_product.has_only_default_variant == false and product_card_product.options.size == 1 and settings.type_color_swatch == 'standart' %}
							<a href="{{ product_card_product.url }}" class="card__more button button--simple button--arrow">
								<span>{{ settings.more_label }}</span>
								{% render 'icon-button-arrow' %}
							</a>
						{% endif %}
					{% endif %}
				{% endif %}
			</div>
			<div class="card-purchase-area">
				<div class="price price--card{% if lowest_price_variant.compare_at_price > lowest_price_variant.price %} price--on-sale{% endif %}">
					{%- if lowest_price_variant.compare_at_price > lowest_price_variant.price -%}
						<div class="price__sale">
							<span class="price-item price-item--sale">
								{{ lowest_price_variant.price | money }}
							</span>
							<span class="price-item price-item--regular">
								<s>{{ lowest_price_variant.compare_at_price | money }}</s>
							</span>
						</div>
					{%- else -%}
						<div class="price__regular">
							<span class="price-item price-item--regular">
								{{ lowest_price_variant.price | money }}
							</span>
						</div>
					{%- endif -%}
				</div>
			<div class="product-parameters">
				{%- unless product_card_product.has_only_default_variant -%}
					{%- for option in product_card_product.options_with_values -%}
						{%- liquid
							assign color_trigger = settings.trigger_swatch | handle | strip
							assign name_option = option.name | handle | strip 
						-%}
						{%- if settings.type_color_swatch == 'custom' and color_trigger == name_option and option.values.size > 1 -%}
							<div class="product-form__controls js-color-swatches">
								<div class="product-form__controls-group">
									{% render 'product-variant-options', 
										product: product_card_product, 
										option: option, 
										no_form_id: true 
									%}
								</div>
							</div>
						{%- endif -%}
					{%- endfor -%}
				{%- endunless -%}
			</div>
			<div class="card-actions">
				<div class="card-actions__buy">
		{%- if settings.add_to_cart_enabled and product_card_product.selected_or_first_available_variant.available and product_card_product.has_only_default_variant or product_card_product.options.size == 1 and settings.type_color_swatch == 'custom' and  product_card_product.options[0] == settings.trigger_swatch -%}
			{%- assign product_form_id = 'quick-add-'
				| append: section_id
				| append: product_card_product.id
			-%}
			<product-form class="card__add-to-cart card__button">
				{%- form 'product',
					product_card_product,
					id: product_form_id,
					class: 'form',
					novalidate: 'novalidate',
					data-type: 'add-to-cart-form'
				-%}
					<input
						type="hidden"
						name="id"
						value="{{ product_card_product.selected_or_first_available_variant.id }}"
						disabled
					>
					<button
						id="{{ product_form_id }}-submit"
						type="submit"
						class="card__link button 
							button--{{ settings.quickview_button_style }} 
							card__link--{{ settings.quickview_button_layout }}
							{% if settings.show_on_mobile -%}card__link--show{%- endif %}
							card-focused"
						name="add"
						aria-haspopup="dialog"
						aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ product_card_product.id }}"
						aria-live="polite"
						data-sold-out-message="true"
						{% if product_card_product.selected_or_first_available_variant.available == false %}
							disabled
						{% endif %}
						aria-label="{{- 'general.card.quick__add' | t -}}"
					>
						{% if settings.quickview_button_style == 'link' %}
							{% render 'icon-cart' %}
						{% else %}
							<span class="card__quickview-text"> 
								{{- 'general.card.quick__add' | t -}}
							</span>
						{% endif %}
						<span class="sold-out-message hidden">
							{{ 'products.product.sold_out' | t }}
						</span>
						<div class="loading-overlay__spinner hidden">
							<svg
								aria-hidden="true"
								focusable="false"
								role="presentation"
								class="spinner"
								viewBox="0 0 66 66"
								xmlns="http://www.w3.org/2000/svg"
							>
								<circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
							</svg>
						</div>
                     Add to Cart   
					</button>
				{%- endform -%}
			</product-form>
		{%- elsif settings.quickview_show -%}
			<div class="quick-add no-js-hidden">
				{%- assign product_form_id = 'quick-add-'
					| append: section_id
					| append: product_card_product.id
				-%}
				<modal-opener data-modal="#QuickAdd-{{ product_card_product.id }}">
					<button
						id="{{ product_form_id }}-submit"
						type="submit"
						name="add"
						class="card__link button 
							button--{{ settings.quickview_button_style }} card__link--{{ settings.quickview_button_layout }}
							{%- if settings.show_on_mobile -%}card__link--show{%- endif %}
							card-focused"
						aria-haspopup="dialog"
						aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ product_card_product.id }}"
						data-product-url="{{ product_card_product.url }}"
					>
						{% if settings.quickview_button_style == 'link' %}
							{% render 'icon-eye' %}
						{% else %}
							<span class="card__quickview-text">
								{{- 'general.card.quick__view' | t -}}
							</span>
						{% endif %}
						<div class="loading-overlay__spinner hidden">
							<svg
								aria-hidden="true"
								focusable="false"
								role="presentation"
								class="spinner"
								viewBox="0 0 66 66"
								xmlns="http://www.w3.org/2000/svg"
							>
								<circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
							</svg>
						</div>
                        Buy Now
					</button>
				</modal-opener>
				<quick-add-modal
					id="QuickAdd-{{ product_card_product.id }}"
					class="quick-add-modal"
				>
					<div
						role="dialog"
						aria-label="{{ 'products.product.choose_product_options' | t: product_name: product_card_product.title | escape }}"
						aria-modal="true"
						class="quick-add-modal__content global-settings-popup"
					>
						<button
							id="ModalClose-{{ product_card_product.id }}"
							type="button"
							class="quick-add-modal__toggle modal-close-button"
							aria-label="{{ 'accessibility.close' | t }}"
							tabindex="-1"
						>
							{% render 'icon-close' %}
						</button>
						<div class="quick-add-modal__content-wrapper">
							<div
								id="QuickAddInfo-{{ product_card_product.id }}"
								class="quick-add-modal__content-info"
							></div>
						</div>
					</div>
				</quick-add-modal>
			</div>
		{%- endif -%}
				</div>
				<a
					href="{{ product_card_product.url }}"
					class="card__learn-more"
					aria-label="Learn more about {{ product_card_product.title | escape }}"
				>
					Learn More
				</a>
			</div>
		</div>
			{%- if show_desc and product_card_product.description != blank -%}
				<div class="card__description">
					{{ product_card_product.description | strip_html | truncate: 120 }}
				</div>
			{%- endif -%}
		</div>
	</div>
	
<script>
  document.addEventListener('click', function(event) {
    const summary = event.target.closest('.product-included-devices__details > summary');
    if (!summary) return;
    event.stopPropagation();
  });
</script>

<a
		href="{{ product_card_product.url | default: '#' }}"
		class="link link--overlay card-wrapper__link--overlay js-color-swatches-link"
		aria-label="{{ 'accessibility.product_link' | t }}"
	></a>
</div>
