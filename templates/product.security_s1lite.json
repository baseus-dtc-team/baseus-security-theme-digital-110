=\"abc-btn\"\n              onclick=\"copyDiscountCode('{{product.metafields.custom.bf_discount}}')\"\n              style=\"\n                padding: 0px 10px;\n                border-radius: 5px;\n                text-decoration: underline;\n                color: #405de6;    background: none;\n    border: none;\n    cursor: pointer;\n              \"\n            >\n              Copy\n            <\/button>\n          <\/div>\n        <\/div>\n      <\/div>\n    <\/div>\n    {%- endif -%}\n    {%- endif -%}\n    <script>\n      function copyDiscountCode(val) {\n        var codeText = val;\n        \/\/ Create a temporary input element to copy the code\n        var tempInput = document.createElement(\"input\");\n        tempInput.value = codeText;\n        document.body.appendChild(tempInput);\n        tempInput.select();\n        document.execCommand(\"copy\");\n        document.body.removeChild(tempInput);\n\n        \/\/ Change the button text to \"Copied\" and update style\n        var copyButton = document.getElementById(\"abc-btn\");\n        copyButton.innerHTML = \"Copied\";\n        \/\/ copyButton.style.backgroundColor = '#ffffff';  copyButton.style.color = '#405de6';\n      }\n    <\/script>"}},"buy_buttons":{"type":"buy_buttons","settings":{"show_dynamic_checkout":true,"show_quantity":true,"show_gift_card_recipient":false}},"custom_liquid_dnnbH4":{"type":"custom_liquid","disabled":true,"settings":{"custom_liquid":"<a href=\"https:\/\/security.baseus.com\/pages\/brand-day-2026\" target=\"_blank\">\n  <img \n    src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0895\/4252\/5298\/files\/Baseus_Anniversary_Aale_2026_product_page_ads_IPC.jpg?v=1775641518\" \n    alt=\"Brand Day 2026\"\n    width=\"684\"\n    height=\"176\"\n    style=\"display:block; width:100%; max-width:684px; height:auto;\"\n  >\n<\/a>"}},"custom_liquid_zpV78N":{"type":"custom_liquid","name":"Shipping Protection","settings":{"custom_liquid":"<div style=\"font-size: 12px; display: flex; ali