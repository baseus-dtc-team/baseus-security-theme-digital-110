cument.body.appendChild(el);\n      let selected =\n        document.getSelection().rangeCount > 0\n          ? document.getSelection().getRangeAt(0)\n          : false;\n      el.select();\n      document.execCommand(\"copy\");\n      document.body.removeChild(el);\n      if (selected) {\n        document.getSelection().removeAllRanges();\n        document.getSelection().addRange(selected);\n      }\n    }\n    function copyCode(e) {\n      let $this = e.target;\n      copyToClipboard($this.getAttribute(\"data-code\"));\n      $this.innerText = \"copied!\";\n      setTimeout(function () {\n        $this.innerText = \"copy\";\n      }, 1500);\n    }\n  <\/script>\n<\/div>"}},"custom_liquid_XQyGnC":{"type":"custom_liquid","disabled":true,"settings":{"custom_liquid":"<br><\/br\n>"}},"multiline_text_UcAAeB":{"type":"multiline_text","settings":{"multiline_text":"<p>{{ product.metafields.custom._productsellingpoints1 | metafield_tag }}<\/p>"}},"multiline_text_zk9XN4":{"type":"multiline_text","settings":{"multiline_text":"<p>{{ product.metafields.custom._productsellingpoints2 | metafield_tag }}<\/p>"}},"description":{"type":"description","disabled":true,"settings":{"description":""}},"tags":{"type":"tags","disabled":true,"settings":{}},"variant_picker":{"type":"variant_picker","settings":{"picker_type":"button"}},"inventory":{"type":"inventory","settings":{}},"custom_liquid_EGYnbr":{"type":"custom_liquid","name":"copy coupon section","settings":{"custom_liquid":"<style>\n      .codecard-contain {\n        position: relative;\n        width: 100%;\n      }\n      .codecard-contain img {\n        width: 100%;\n      }\n      .codecard-textbox {\n        position: absolute;\n        top: 0;\n        display: flex;\n        width: 100%;\n        height: 100%;\n        align-items: center;\n        color: #ffffff;\n      }\n      .codecard-price-box {\n        width: 35%;\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        font-size